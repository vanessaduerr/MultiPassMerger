import tkinter as tk
from tkinter import filedialog, messagebox
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.linear_model import LinearRegression
import numpy as np
import os
from matplotlib.cm import get_cmap
from datetime import datetime
import subprocess

class TrendlineApp:
    def __init__(self, root):
        self.root = root
        self.root.title("Mobility Trendline Finder")
        self.root.geometry("600x500")  # Adjusted window size since the plot area is removed

        # Parameter inputs
        self.create_parameter_inputs()

    def create_parameter_inputs(self):
        row_idx = 0
        tk.Label(self.root, text="RAW Folder:").grid(row=row_idx, column=0, padx=5, pady=5, sticky='e')
        self.input_entry = tk.Entry(self.root, width=50)
        self.input_entry.grid(row=row_idx, column=1, padx=5, pady=5)
        tk.Button(self.root, text="Browse", command=self.browse_raw_folder).grid(row=row_idx, column=2, padx=5, pady=5)
        row_idx += 1

        tk.Label(self.root, text="Output Folder:").grid(row=row_idx, column=0, padx=5, pady=5, sticky='e')
        self.output_entry = tk.Entry(self.root, width=50)
        self.output_entry.grid(row=row_idx, column=1, padx=5, pady=5)
        tk.Button(self.root, text="Browse", command=self.browse_output_folder).grid(row=row_idx, column=2, padx=5, pady=5)
        row_idx += 1

        tk.Label(self.root, text="Trendline Numbers (min 4):").grid(row=row_idx, column=0, padx=5, pady=5, sticky='e')
        self.trendline_entry = tk.Entry(self.root, width=10)
        self.trendline_entry.grid(row=row_idx, column=1, padx=5, pady=5, sticky='w')
        self.trendline_entry.insert(0, "5")  # Default value
        row_idx += 1

        # Thresholds low/high energy 
        tk.Label(self.root, text="Low Energy Threshold:").grid(row=row_idx, column=0, padx=5, pady=5, sticky='e')
        self.le_threshold_entry = tk.Entry(self.root, width=10)
        self.le_threshold_entry.grid(row=row_idx, column=1, padx=5, pady=5, sticky='w')
        self.le_threshold_entry.insert(0, "300")
        row_idx += 1

        tk.Label(self.root, text="High Energy Threshold:").grid(row=row_idx, column=0, padx=5, pady=5, sticky='e')
        self.he_threshold_entry = tk.Entry(self.root, width=10)
        self.he_threshold_entry.grid(row=row_idx, column=1, padx=5, pady=5, sticky='w')
        self.he_threshold_entry.insert(0, "150")
        row_idx += 1

        # Retention time thresholds
        tk.Label(self.root, text="Retention Start Time (min):").grid(row=row_idx, column=0, padx=5, pady=5, sticky='e')
        self.ret_start_entry = tk.Entry(self.root, width=10)
        self.ret_start_entry.grid(row=row_idx, column=1, padx=5, pady=5, sticky='w')
        self.ret_start_entry.insert(0, "1.0")
        row_idx += 1

        tk.Label(self.root, text="Retention End Time (min):").grid(row=row_idx, column=0, padx=5, pady=5, sticky='e')
        self.ret_end_entry = tk.Entry(self.root, width=10)
        self.ret_end_entry.grid(row=row_idx, column=1, padx=5, pady=5, sticky='w')
        self.ret_end_entry.insert(0, "10")
        row_idx += 1

        # Initial Trendline (important to make it process something)
        tk.Label(self.root, text="Initial Trendline (e.g., 11-13):").grid(row=row_idx, column=0, padx=5, pady=5, sticky='e')
        self.initial_trendline_entry = tk.Entry(self.root, width=15)
        self.initial_trendline_entry.grid(row=row_idx, column=1, padx=5, pady=5, sticky='w')
        self.initial_trendline_entry.insert(0, "11-13")
        row_idx += 1

        # LockMass Z1
        tk.Label(self.root, text="LockMass Z1:").grid(row=row_idx, column=0, padx=5, pady=5, sticky='e')
        self.lockmass_z1_entry = tk.Entry(self.root, width=15)
        self.lockmass_z1_entry.grid(row=row_idx, column=1, padx=5, pady=5, sticky='w')
        self.lockmass_z1_entry.insert(0, "556.2771")
        row_idx += 1

        # LockMass Z2
        tk.Label(self.root, text="LockMass Z2:").grid(row=row_idx, column=0, padx=5, pady=5, sticky='e')
        self.lockmass_z2_entry = tk.Entry(self.root, width=15)
        self.lockmass_z2_entry.grid(row=row_idx, column=1, padx=5, pady=5, sticky='w')
        row_idx += 1

        # Modify Resolution checkbox
        self.modify_resolution_var = tk.BooleanVar(value=True)  # Pre-ticked
        self.modify_resolution_check = tk.Checkbutton(self.root, text="Change Resolution to 40000", variable=self.modify_resolution_var)
        self.modify_resolution_check.grid(row=row_idx, column=0, columnspan=3, padx=5, pady=10, sticky='w')
        row_idx += 1

        # Process button
        tk.Button(self.root, text="Process", command=self.process).grid(row=row_idx, column=0, columnspan=3, pady=20)

    def browse_raw_folder(self):
        folder_path = filedialog.askdirectory(title="Select RAW Folder")
        if folder_path and folder_path.endswith('.raw'):
            self.input_entry.delete(0, tk.END)
            self.input_entry.insert(0, folder_path)
        else:
            messagebox.showerror("Error", "Please select a folder with the .raw extension.")

    def browse_output_folder(self):
        folder_path = filedialog.askdirectory(title="Select Output Folder")
        if folder_path:
            self.output_entry.delete(0, tk.END)
            self.output_entry.insert(0, folder_path)

    def process(self):
        raw_folder = self.input_entry.get()
        output_folder = self.output_entry.get()

        # Get parameters
        try:
            n = int(self.trendline_entry.get())
            if n < 4:
                raise ValueError("Trendline numbers must be at least 4.")
            num_clusters = n - 1
        except ValueError:
            messagebox.showerror("Error", "Trendline numbers must be an integer greater than or equal to 4.")
            return

        le_threshold = self.le_threshold_entry.get()
        he_threshold = self.he_threshold_entry.get()
        ret_start = self.ret_start_entry.get()
        ret_end = self.ret_end_entry.get()
        initial_trendline = self.initial_trendline_entry.get()
        lockmass_z1 = self.lockmass_z1_entry.get()
        lockmass_z2 = self.lockmass_z2_entry.get()
        modify_resolution = self.modify_resolution_var.get()

        if not raw_folder or not os.path.isdir(raw_folder) or not raw_folder.endswith('.raw'):
            messagebox.showerror("Error", "Please select a valid RAW folder ending with '.raw'.")
            return

        if not output_folder or not os.path.isdir(output_folder):
            messagebox.showerror("Error", "Please select a valid output folder.")
            return

        if not initial_trendline or "-" not in initial_trendline:
            messagebox.showerror("Error", "Please provide a valid initial trendline (e.g., 11-13).")
            return

        try:
            driftFWHMStart, driftFWHMEnd = initial_trendline.split("-")
            driftFWHMStart = float(driftFWHMStart)
            driftFWHMEnd = float(driftFWHMEnd)
        except ValueError:
            messagebox.showerror("Error", "Invalid initial trendline format.")
            return

        try:
            le_threshold = int(le_threshold)
            he_threshold = int(he_threshold)
            ret_start = float(ret_start)
            ret_end = float(ret_end)
            lockmass_z1 = float(lockmass_z1)
            if lockmass_z2:
                lockmass_z2 = float(lockmass_z2)
        except ValueError:
            messagebox.showerror("Error", "Numeric fields must contain valid numbers.")
            return

        try:
            # Modify resolution (if picked by user)
            if modify_resolution:
                self.modify_resolution_in_folder(raw_folder, 40000)

            # unique timestamp 
            timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")

            # Create main Apex3D output directory 
            apex3d_main_output_dir = os.path.join(os.path.dirname(output_folder), "Apex3D_outputs")
            os.makedirs(apex3d_main_output_dir, exist_ok=True)

            # Create timestamped subfolder
            apex3d_output_folder = os.path.join(apex3d_main_output_dir, f"Apex3D_output_{timestamp}")
            os.makedirs(apex3d_output_folder, exist_ok=True)

            # Correct path separators for batch file
            apex3d_output_folder_batch = apex3d_output_folder.replace("\\", "/")
            raw_folder_batch = raw_folder.replace("\\", "/")

            # Generate Apex3D command
            apex_exe_path = r"C:\PLGS3.0.3\lib\apex3d\Apex3d64.exe"

            apex_command = f'"{apex_exe_path}"'
            apex_command += f' -pRawDirName "{raw_folder_batch}"'
            apex_command += f' -outputDirName "{apex3d_output_folder_batch}"'
            apex_command += f' -outputUserDirName "{apex3d_output_folder_batch}"'
            apex_command += f' -lockMassZ1 {lockmass_z1}'
            if lockmass_z2:
                apex_command += f' -lockMassZ2 {lockmass_z2}'
            apex_command += f' -lockMassToleranceAMU 0.3'
            apex_command += f' -leThresholdCounts {le_threshold}'
            apex_command += f' -heThresholdCounts {he_threshold}'
            apex_command += f' -startingRTMin {ret_start}'
            apex_command += f' -endingRTMin {ret_end}'
            apex_command += f' -driftFWHMStart {driftFWHMStart}'
            apex_command += f' -driftFWHMEnd {driftFWHMEnd}'
            apex_command += f' -PLGS\n'

            # Create batch file
            batch_file_path = os.path.join(output_folder, f"run_apex3d_{timestamp}.bat")
            with open(batch_file_path, 'w') as batch_file:
                batch_file.write(f'@echo off\n')
                batch_file.write(apex_command)
                # Add mkdir command if needed
                peptide_output_dir = os.path.join(os.path.dirname(output_folder), "FINAL_processed_files_Peptide3D", f"{int(driftFWHMStart)}_{int(driftFWHMEnd)}")
                peptide_output_dir_batch = peptide_output_dir.replace("\\", "/")
                mkdir_command = f'mkdir "{peptide_output_dir_batch}"\n'
                batch_file.write(mkdir_command)
                batch_file.write('pause\n')  # Keeps the command prompt open after execution

            # Save a copy of batch file as .txt
            batch_txt_path = os.path.join(output_folder, f"run_apex3d_{timestamp}.txt")
            with open(batch_txt_path, 'w') as batch_txt_file:
                batch_txt_file.write(apex_command)
                batch_txt_file.write(mkdir_command)

            # Execute batch file
            subprocess.Popen(batch_file_path, creationflags=subprocess.CREATE_NEW_CONSOLE)

            # Wait for batch file to finish
            messagebox.showinfo("Processing", "Apex3D is processing. Click OK when processing is complete.")
            # In actual implementation, consider checking for process completion automatically.

            # Process Apex3DIons file
            # Find the Apex3DIons file in the output folder
            ions_file = None
            for file in os.listdir(apex3d_output_folder):
                if file.endswith("Apex3DIons") or file.endswith("Apex3DIons.csv"):
                    ions_file = os.path.join(apex3d_output_folder, file)
                    break

            if not ions_file or not os.path.isfile(ions_file):
                messagebox.showerror("Error", f"Apex3DIons file not found in {apex3d_output_folder}")
                return

            # Load data
            data = pd.read_csv(ions_file)
            if not {'mobility', 'mobilityFWHM', 'inten'}.issubset(data.columns):
                messagebox.showerror("Error", "Required columns not found in the Apex3DIons file.")
                return

            # Extract the top 2000 most intense ions
            data_top = data.nlargest(min(2000, len(data)), 'inten')
            X = data_top['mobility'].values.reshape(-1, 1)
            y = data_top['mobilityFWHM'].values

            # Initialize cluster assignments randomly
            np.random.seed(42)
            cluster_assignments = np.random.randint(0, num_clusters, len(X))

            # Initialize regression models
            models = [LinearRegression() for _ in range(num_clusters)]

            # Iterate until clusters stabilize
            max_iter = 100
            for iteration in range(max_iter):
                for k in range(num_clusters):
                    indices = np.where(cluster_assignments == k)[0]
                    if len(indices) > 0:
                        models[k].fit(X[indices], y[indices])

                # Reassign clusters based on regression errors
                errors = np.zeros((len(X), num_clusters))
                for k in range(num_clusters):
                    if len(np.where(cluster_assignments == k)[0]) > 0:
                        errors[:, k] = np.abs(models[k].predict(X) - y)
                    else:
                        errors[:, k] = np.inf

                new_assignments = np.argmin(errors, axis=1)

                if np.array_equal(cluster_assignments, new_assignments):
                    break

                cluster_assignments = new_assignments

            max_x = np.max(X)
            min_x = np.min(X)
            X_fit = np.linspace(min_x, max_x, 100).reshape(-1, 1)

            cmap = get_cmap("tab10")
            colors = [cmap(i / num_clusters) for i in range(num_clusters)]

            # Create matplotlib figure and axes
            fig, ax = plt.subplots(figsize=(10, 6))  # Increased figure size

            # Generate timestamped output file name
            output_file = os.path.join(output_folder, f"trendline_results_{timestamp}.txt")

            trendline_labels = []

            # Variables for highest trendline
            highest_y_fit = None
            highest_slope = None
            highest_intercept = None

            # Plot trendlines for clusters
            for k in range(num_clusters):
                indices = np.where(cluster_assignments == k)[0]
                if len(indices) > 0:
                    models[k].fit(X[indices], y[indices])
                    y_fit = models[k].predict(X_fit)
                    # Compute trendline label
                    start_y = y_fit[0]
                    end_y = y_fit[-1]
                    trendline_label = f"{start_y:.2f}-{end_y:.2f}"
                    trendline_labels.append(trendline_label)
                    # Plot data points and trendline
                    ax.scatter(X[indices], y[indices], color=colors[k], label=f"{trendline_label}", s=10)
                    ax.plot(X_fit, y_fit, color=colors[k])
                    # Check if this is the highest trendline
                    avg_y_fit = np.mean(y_fit)
                    if highest_y_fit is None or avg_y_fit > highest_y_fit:
                        highest_y_fit = avg_y_fit
                        highest_slope = models[k].coef_[0]
                        highest_intercept = models[k].intercept_
                else:
                    print(f"Cluster {k} has no data points.")

            # Create the additional trendline 5 units above the highest trendline
            if highest_slope is not None and highest_intercept is not None:
                additional_intercept = highest_intercept + 5
                y_fit_additional = highest_slope * X_fit.flatten() + additional_intercept
                ax.plot(X_fit, y_fit_additional, color='black', linestyle='--', label="Additional Trendline")
                # Compute trendline label
                start_y = y_fit_additional[0]
                end_y = y_fit_additional[-1]
                trendline_labels.append(f"{start_y:.2f}-{end_y:.2f}")
            else:
                messagebox.showerror("Error", "Failed to compute the additional trendline.")
                return

            ax.legend(loc="best")
            ax.set_xlabel("Mobility")
            ax.set_ylabel("Mobility FWHM")
            ax.set_title("Regression-based Clustering with Linear Trendlines")
            ax.grid(True)

            # Display plot 
            plt.show()

            # Write trendline labels 
            with open(output_file, "w", encoding="utf-8") as file:
                file.write(f"File analyzed: {raw_folder}\n")
                file.write("Trendlines (start-end format):\n")
                results_line = ', '.join(trendline_labels)
                file.write(results_line + '\n')

            # Automatically open the notepad file
            try:
                os.startfile(output_file)
            except Exception as e:
                messagebox.showwarning("Warning", f"Could not open the output file automatically. Error: {e}")

            messagebox.showinfo("Success", f"Analysis complete. Results saved to: {output_file}")

        except Exception as e:
            print(f"Error: {e}")
            messagebox.showerror("Error", str(e))

    def modify_resolution_in_folder(self, folder_path, new_resolution):
        for root, dirs, files in os.walk(folder_path):
            for file in files:
                if file.endswith("_extern.inf"):
                    file_path = os.path.join(root, file)
                    with open(file_path, 'r') as f:
                        lines = f.readlines()
                    modified_lines = []
                    for line in lines:
                        if line.startswith("Resolution"):
                            modified_lines.append("Resolution\t\t\t{:.2f}\n".format(new_resolution))
                        else:
                            modified_lines.append(line)
                    with open(file_path, 'w') as f:
                        f.writelines(modified_lines)

if __name__ == "__main__":
    root = tk.Tk()
    app = TrendlineApp(root)
    root.mainloop()
