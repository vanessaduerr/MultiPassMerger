# Change the resolution to 40000 for resolution MassLynx bug 
def modify_resolution_in_folder(folder_path, new_resolution):
    for root, dirs, files in os.walk(folder_path):
        for file in files:
            if file.endswith("_extern.inf"):
                file_path = os.path.join(root, file)
                with open(file_path, 'r', encoding='latin-1') as f:
                    lines = f.readlines()
                modified_lines = []
                for line in lines:
                    if line.startswith("Resolution"):
                        modified_lines.append("Resolution\t\t\t{:.2f}\n".format(new_resolution))
                    else:
                        modified_lines.append(line)
                with open(file_path, 'w', encoding='latin-1') as f:
                    f.writelines(modified_lines)

def generate_files(input_folder, apex_output_folder, plgs_final_output_folder, 
                   le_threshold_counts, he_threshold_counts, starting_rt_min, ending_rt_min, 
                   trendline_ranges, modify_resolution, lockmass_z1_value, lockmass_z2_value, 
                   lockmass_tol_value, is_single_pass, apex_exe_name):
    # Create the output folders (inside user-specified output folder)
    if not os.path.exists(apex_output_folder):
        os.makedirs(apex_output_folder)
    if not os.path.exists(plgs_final_output_folder):
        os.makedirs(plgs_final_output_folder)
    
    # batch_files folder inside Output folder.
    # We use the directory of the apex_output_folder (which is inside Output).
    batch_file_folder = os.path.join(os.path.dirname(apex_output_folder), "batch_files")
    if not os.path.exists(batch_file_folder):
        os.makedirs(batch_file_folder)

    if is_single_pass:
        batch_file_name = "SinglePass_PLGS_Processing_commands.bat"
        notepad_file_name = "SinglePass_PLGS_Processing_commands.txt"
    else:
        batch_file_name = "MultiPass_PLGS_Processing_commands.bat"
        notepad_file_name = "MultiPass_PLGS_Processing_commands.txt"
    
    notepad_file_path = os.path.join(batch_file_folder, notepad_file_name)
    batch_file_path = os.path.join(batch_file_folder, batch_file_name)

    if modify_resolution:
        modify_resolution_in_folder(input_folder, 40000)

    with open(notepad_file_path, "w", encoding='latin-1') as notepad_file, \
         open(batch_file_path, "w", encoding='latin-1') as batch_file:
        
        raw_folders = find_raw_folders(input_folder)
        # path to the Apex executable.
        apex_exe_path = f'"C:\\PLGS3.0.3\\lib\\apex3d\\{apex_exe_name}"'
        
        for raw_folder in raw_folders:
            raw_folder_name = os.path.basename(raw_folder)
            raw_file_name = raw_folder_name.split('.')[0]
            # different binary name if ApexRT is selected
            if "ApexRT" in apex_exe_name:
                bin_file_name = f"{raw_file_name}_ApexRT.bin"
            else:
                bin_file_name = f"{raw_file_name}_Apex3D.bin"
            
            if is_single_pass:
                apex_command = f'{apex_exe_path} -pRawDirName "{raw_folder}" -outputDirName "{apex_output_folder}" -outputUserDirName "{apex_output_folder}"'
                if lockmass_z1_value:
                    apex_command += f' -lockMassZ1 {lockmass_z1_value}'
                if lockmass_z2_value:
                    apex_command += f' -lockMassZ2 {lockmass_z2_value}'
                apex_command += f' -lockMassToleranceAMU {lockmass_tol_value}'
                if le_threshold_counts != 0:
                    apex_command += f' -leThresholdCounts {le_threshold_counts}'
                if he_threshold_counts != 0:
                    apex_command += f' -heThresholdCounts {he_threshold_counts}'
                if starting_rt_min != 0:
                    apex_command += f' -startingRTMin {starting_rt_min}'
                if ending_rt_min != 0:
                    apex_command += f' -endingRTMin {ending_rt_min}'
                apex_command += ' -PLGS\n'
                print("Generated single-pass command:", apex_command)
                notepad_file.write(apex_command)
                batch_file.write(apex_command)
                
                peptide_output_dir = os.path.join(plgs_final_output_folder, "1_1")
                os.makedirs(peptide_output_dir, exist_ok=True)
                create_output_dir_command = f'mkdir "{peptide_output_dir}"\n'
                peptide_command = f'"C:\\PLGS3.0.3\\lib\\apex3d\\Peptide3D.exe" -inputXMLFileName "{os.path.join(apex_output_folder, bin_file_name)}" -outputDirName "{peptide_output_dir}" -outputUserDirName "{peptide_output_dir}"\n'
                notepad_file.write(create_output_dir_command)
                batch_file.write(create_output_dir_command)
                notepad_file.write(peptide_command)
                batch_file.write(peptide_command)
                
            else:
                for trendline_range in trendline_ranges:
                    apex_command = f'{apex_exe_path} -pRawDirName "{raw_folder}" -outputDirName "{apex_output_folder}" -outputUserDirName "{apex_output_folder}"'
                    if lockmass_z1_value:
                        apex_command += f' -lockMassZ1 {lockmass_z1_value}'
                    if lockmass_z2_value:
                        apex_command += f' -lockMassZ2 {lockmass_z2_value}'
                    apex_command += f' -lockMassToleranceAMU {lockmass_tol_value}'
                    if le_threshold_counts != 0:
                        apex_command += f' -leThresholdCounts {le_threshold_counts}'
                    if he_threshold_counts != 0:
                        apex_command += f' -heThresholdCounts {he_threshold_counts}'
                    if starting_rt_min != 0:
                        apex_command += f' -startingRTMin {starting_rt_min}'
                    if ending_rt_min != 0:
                        apex_command += f' -endingRTMin {ending_rt_min}'
                    apex_command += f' -driftFWHMStart {trendline_range.split("-")[0]} -driftFWHMEnd {trendline_range.split("-")[1]}'
                    apex_command += ' -PLGS\n'
                    print("Generated multi-pass command:", apex_command)
                    notepad_file.write(apex_command)
                    batch_file.write(apex_command)
                    
                    peptide_output_dir = os.path.join(plgs_final_output_folder, trendline_range.replace('-', '_'))
                    create_output_dir_command = f'mkdir "{peptide_output_dir}"\n'
                    peptide_command = f'"C:\\PLGS3.0.3\\lib\\apex3d\\Peptide3D.exe" -inputXMLFileName "{os.path.join(apex_output_folder, bin_file_name)}" -outputDirName "{peptide_output_dir}" -outputUserDirName "{peptide_output_dir}"\n'
                    print("Generated peptide command (multi-pass):", peptide_command)
                    notepad_file.write(create_output_dir_command)
                    batch_file.write(create_output_dir_command)
                    notepad_file.write(peptide_command)
                    batch_file.write(peptide_command)

    print(f"Notepad file generated successfully at {notepad_file_path}")
    print(f"Batch file generated successfully at {batch_file_path}")
    
    # Notepad file copy of batch file so people can see what was processed to double check it.
    copy_dest = os.path.join(apex_output_folder, "Apex_and_Peptide3D_commands.txt")
    with open(notepad_file_path, 'r', encoding='latin-1') as src:
        contents = src.read()
    with open(copy_dest, 'w', encoding='latin-1') as dst:
        dst.write(contents)
    
    return batch_file_path

def find_raw_folders(input_folder):
    raw_folders = []
    for root, dirs, files in os.walk(input_folder):
        for dir in dirs:
            if dir.endswith(".raw"):
                raw_folders.append(os.path.join(root, dir))
    return raw_folders

def browse_directory(entry_widget):
    directory = filedialog.askdirectory()
    if directory:
        entry_widget.delete(0, tk.END)
        entry_widget.insert(0, directory)

def browse_file(entry_widget):
    file = filedialog.askopenfilename(filetypes=[("All files", "*.*")])
    if file:
        entry_widget.delete(0, tk.END)
        entry_widget.insert(0, file)

def run_batch_file(batch_file_path):
    try:
        process = subprocess.Popen(['cmd', '/c', batch_file_path], creationflags=subprocess.CREATE_NEW_CONSOLE)
        process.communicate()
        if process.returncode != 0:
            print(f"Error executing batch file: {batch_file_path}\nReturn code: {process.returncode}")
            messagebox.showerror("Error", f"An error occurred while executing the batch file: {batch_file_path}\nReturn code: {process.returncode}")
        else:
            print(f"Batch file executed successfully: {batch_file_path}")
    except Exception as e:
        print(f"Failed to run the batch file: {batch_file_path}\nError: {e}")
        messagebox.showerror("Error", f"Failed to run the batch file: {batch_file_path}\nError: {e}")

def generate_final_files(bin_dir, para_xml_dir, fasta_file_path, final_output_dir):
    fasta_filename = os.path.basename(fasta_file_path)
    if not os.path.isdir(bin_dir) or not os.path.isfile(fasta_file_path):
        messagebox.showerror("Error", "Invalid directory or file selected for bin or FASTA.")
        return
    para_xml_file_path = para_xml_dir
    batch_file_contents = []
    batch_file_folder = os.path.join(os.path.dirname(bin_dir), "batch_files")
    if not os.path.exists(batch_file_folder):
        os.makedirs(batch_file_folder)
    batch_file_path = os.path.join(batch_file_folder, "combined_final_processing.bat")
    notepad_file_path = os.path.join(batch_file_folder, "final_processing_contents.txt")
    for subdir, _, files in os.walk(bin_dir):
        for file in files:
            if file.endswith('.bin'):
                bin_file_path = os.path.join(subdir, file)
                relative_path = os.path.relpath(subdir, bin_dir)
                output_subdir = os.path.join(final_output_dir, relative_path)
                if not os.path.exists(output_subdir):
                    os.makedirs(output_subdir)
                command = (
                    f'SET "paraXMLFileName={para_xml_file_path}"\n'
                    f'SET "pep3DFileName={bin_file_path}"\n'
                    f'SET "proteinFASTAFileName={fasta_file_path}"\n'
                    f'SET "outPutDirName={output_subdir}"\n'
                    f'SET "outputUserDirName={output_subdir}"\n\n'
                    f'"C:\\PLGS3.0.3\\bin\\iaDBs.exe" '
                    f'-paraXMLFileName "%paraXMLFileName%" '
                    f'-pep3DFileName "%pep3DFileName%" '
                    f'-proteinFASTAFileName "%proteinFASTAFileName%" '
                    f'-outPutDirName "%outPutDirName%" '
                    f'-outputUserDirName "%outputUserDirName%"\n\n'
                )
                batch_file_contents.append(command)
    if batch_file_contents:
        with open(batch_file_path, 'w', encoding='latin-1') as batch_file:
            batch_file.writelines(batch_file_contents)
        with open(notepad_file_path, 'w', encoding='latin-1') as notepad_file:
            notepad_file.writelines(batch_file_contents)
        print(f"Final processing batch file created at: {batch_file_path}")
        run_batch_file(batch_file_path)
        messagebox.showinfo("Processing Finished", 
            f"The processing is finished. Find your final_peptide.csv files in {final_output_dir}.\nReturn to the main interface to proceed to merge and filter them into a single file")
    else:
        messagebox.showwarning("Warning", "No .bin files found in the selected directory.")

def start_process():
    input_folder = input_folder_entry.get().strip()
    single_pass_folder = single_pass_entry.get().strip()
    para_xml_dir = para_xml_entry.get()
    fasta_file_path = fasta_entry.get()
    output_dir = output_dir_entry.get()
    if not input_folder and not single_pass_folder:
        messagebox.showerror("Error", "Please select at least one input folder (Multi-Pass or Single-Pass)")
        return
    if not para_xml_dir.endswith('.xml'):
        messagebox.showerror("Error", "Please specify a valid parameter XML file.")
        return
    # Determine which Apex mode /  'Apex3D' or 'ApexRT'
    apex_mode = apex_mode_var.get()  
    if apex_mode == 'Apex3D':
        apex_exe_name = "Apex3d64.exe"
        apex_folder = "Apex3D_output"
        peptide_folder = "Peptide3D_output"
    else:
        apex_exe_name = "ApexRT.exe"
        apex_folder = "ApexRT_output"
        peptide_folder = "PeptideRT_output"
    # Put output in the user-specified output folder
    apex_output_folder = os.path.join(output_dir, apex_folder)
    plgs_final_output_folder = os.path.join(output_dir, peptide_folder)
    
    le_threshold_counts = int(le_threshold_entry.get())
    he_threshold_counts = int(he_threshold_entry.get())
    starting_rt_min = float(starting_rt_entry.get())
    ending_rt_min = float(ending_rt_entry.get())
    trendline_ranges = trendline_ranges_entry.get().split(",")
    modify_resolution = resolution_checkbox_var.get()
    lockmass_z1_value = lockmass_z1_entry.get().strip()
    lockmass_z2_value = lockmass_z2_entry.get().strip()
    lockmass_tol_value = lockmass_tol_entry.get().strip()
    
    batch_file_paths = []
    if input_folder:
        batch_file_path = generate_files(input_folder, apex_output_folder, plgs_final_output_folder, 
                                         le_threshold_counts, he_threshold_counts, starting_rt_min, 
                                         ending_rt_min, trendline_ranges, modify_resolution, 
                                         lockmass_z1_value, lockmass_z2_value, lockmass_tol_value, 
                                         is_single_pass=False, apex_exe_name=apex_exe_name)
        batch_file_paths.append(batch_file_path)
    if single_pass_folder:
        batch_file_path = generate_files(single_pass_folder, apex_output_folder, plgs_final_output_folder, 
                                         le_threshold_counts, he_threshold_counts, starting_rt_min, 
                                         ending_rt_min, trendline_ranges, modify_resolution, 
                                         lockmass_z1_value, lockmass_z2_value, lockmass_tol_value, 
                                         is_single_pass=True, apex_exe_name=apex_exe_name)
        batch_file_paths.append(batch_file_path)
    for batch_file_path in batch_file_paths:
        run_batch_file(batch_file_path)
    #final output folder with timestamp and Apex mode in its name
    timestamp = time.strftime("%Y%m%d_%H%M%S")
    final_output_folder = os.path.join(output_dir, f"Final_output_files_{timestamp}_{apex_mode}")
    generate_final_files(plgs_final_output_folder, para_xml_dir, fasta_file_path, final_output_folder)

