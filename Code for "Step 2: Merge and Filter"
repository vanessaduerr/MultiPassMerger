import os
import re
import shutil
import tempfile
import pandas as pd
import tkinter as tk
from tkinter import filedialog, messagebox
from datetime import datetime

# Remove extra underscores from file names  
def clean_underscores(file_name):
    return re.sub(r'_{2,}', '_', file_name)

# Extract separation time from file name
def extract_separation_time(file_name):
    ms_match = re.search(r'(\d+)ms', file_name)
    s_match = re.search(r'(\d+)s', file_name)
    if ms_match:
        return ms_match.group(1)
    elif s_match:
        return s_match.group(1)
    else:
        return None  # Return None if no separation time is found

# Extract trendline from folder hierarchy
def extract_trendline(old_path):
    # Start from the folder containing the file and move up
    current_folder = os.path.dirname(old_path)
    while True:
        # Get the base name of the current folder
        folder_name = os.path.basename(current_folder)
        # Check if the folder name consists of two numbers separated by an underscore
        if re.match(r'^\d+_\d+$', folder_name):
            return folder_name
        # Move up one directory
        parent_folder = os.path.dirname(current_folder)
        if parent_folder == current_folder:
            # Reached root directory
            break
        current_folder = parent_folder
    # If no matching folder is found, return 'NoTrendline'
    return 'NoTrendline'

# Rename files based on separation time and trendline
def rename_csv_files(folder_path, temp_folder):
    generated_files = []
    for root, dirs, files in os.walk(folder_path):
        for file in files:
            if file.endswith("IA_final_peptide.csv"):
                old_path = os.path.join(root, file)

                # Extract trendline from folder hierarchy
                trendline = extract_trendline(old_path)

                # Extract separation time from file name
                file_name_without_ext = os.path.splitext(file)[0]
                separation_time = extract_separation_time(file_name_without_ext)

                if not separation_time:
                    separation_time = '0'  # Use '0' if no separation time is found to ensure it still works

                # Create new file name
                rest_of_filename = file_name_without_ext
                new_file_name = f"{separation_time}_{trendline}_{rest_of_filename}.csv"
                new_file_name = clean_underscores(new_file_name)
                new_path = os.path.join(temp_folder, new_file_name)
                shutil.copy2(old_path, new_path)
                generated_files.append(new_path)
    return generated_files

class TrendlineAnalyzerApp:
    def __init__(self, master):
        self.master = master
        master.title("Merging and Filtering")

        self.input_folder = ''
        self.results = ''
        self.proteins_to_exclude = []    # List of proteins to exclude
        self.proteins_to_exclude_set = False  # Flag to check if selection is made

        # Create the GUI elements
        self.create_widgets()

    def create_widgets(self):
        # Define a 2-column layout
        left_frame = tk.Frame(self.master)
        left_frame.grid(row=0, column=0, padx=10, pady=10, sticky='nw')

        right_frame = tk.Frame(self.master)
        right_frame.grid(row=0, column=1, padx=10, pady=10, sticky='ne')

        # Input Folder Section
        self.input_label = tk.Label(left_frame, text="Select Input Folder:")
        self.input_label.grid(row=0, column=0, padx=5, pady=5, sticky='e')

        self.input_entry = tk.Entry(left_frame, width=45)
        self.input_entry.grid(row=0, column=1, padx=5, pady=5, sticky='w')

        self.browse_button = tk.Button(left_frame, text="Browse", command=self.browse_folder)
        self.browse_button.grid(row=0, column=2, padx=0, pady=5, sticky='w')

        # Output text area
        self.output_text = tk.Text(left_frame, width=80, height=25)
        self.output_text.grid(row=1, column=0, columnspan=2, padx=10, pady=10)

        # Add a scrollbar 
        self.scrollbar = tk.Scrollbar(left_frame, command=self.output_text.yview, width=12)
        self.scrollbar.grid(row=1, column=2, sticky='ns')
        self.output_text['yscrollcommand'] = self.scrollbar.set

        # Filtering Parameters Section on the right side

        # Exclude Proteins Checkbox and Label
        self.exclude_proteins_frame = tk.Frame(right_frame)
        self.exclude_proteins_frame.grid(row=0, column=0, columnspan=2, padx=10, pady=5, sticky='w')

        self.exclude_proteins_var = tk.IntVar()
        self.exclude_proteins_checkbox = tk.Checkbutton(
            self.exclude_proteins_frame,
            variable=self.exclude_proteins_var,
            state=tk.DISABLED,
            command=self.exclude_proteins_checked
        )
        self.exclude_proteins_checkbox.pack(side='left')

        self.exclude_proteins_label = tk.Label(
            self.exclude_proteins_frame,
            text="Exclude proteins..."
        )
        self.exclude_proteins_label.pack(side='left')

        self.create_filtering_fields(right_frame)

        # Process Button at the bottom of the right side
        self.process_button = tk.Button(
            right_frame,
            text="Process Files",
            command=self.process_files
        )
        self.process_button.grid(row=15, column=1, padx=10, pady=20)

    def create_filtering_fields(self, parent):
        # Filtering parameters
        self.label_and_entry(parent, "Sample replicate threshold:", "3", 1, 0)
        self.sample_replicate_threshold_entry = self.entry

        self.label_and_entry(parent, "Min. products per amino acid:", "0.11", 2, 0)
        self.min_product_aa_entry = self.entry

        self.label_and_entry(parent, "Min. intensity:", "1000", 3, 0)
        self.precursor_inten_entry = self.entry

        self.label_and_entry(parent, "Min. sequence length:", "5", 4, 0)
        self.min_peptide_length_entry = self.entry

        self.label_and_entry(parent, "Max. sequence length:", "30", 5, 0)
        self.max_peptide_length_entry = self.entry

        self.label_and_entry(parent, "Min. products:", "2", 6, 0)
        self.min_matched_products_entry = self.entry

        self.label_and_entry(parent, "Min. consecutive products:", "1", 7, 0)
        self.min_consec_matched_products_entry = self.entry

        self.label_and_entry(parent, "Min. sum intensity for products:", "472", 8, 0)
        self.min_matched_products_inten_entry = self.entry

        self.label_and_entry(parent, "Min. score:", "6.62", 9, 0)
        self.min_peptide_score_entry = self.entry

        self.label_and_entry(parent, "Min. MH+ error (ppm):", "-5", 10, 0)
        self.min_delta_mhp_ppm_entry = self.entry

        self.label_and_entry(parent, "Max. MH+ error (ppm):", "5", 11, 0)
        self.max_delta_mhp_ppm_entry = self.entry

        self.label_and_entry(parent, "Retention time RSD:", "4", 12, 0)
        self.std_deviation_entry = self.entry

    def label_and_entry(self, parent, label_text, default_value, row, column):
        label = tk.Label(parent, text=label_text)
        label.grid(row=row, column=column, padx=10, pady=5, sticky='e')
        self.entry = tk.Entry(parent, width=15)
        self.entry.insert(0, default_value)
        self.entry.grid(row=row, column=column + 1, padx=10, pady=5, sticky='w')

    def get_int_value(self, value_str):
        value_str = value_str.strip()
        if value_str == '' or value_str == '0':
            return None
        else:
            try:
                return int(value_str)
            except ValueError:
                return None

    def get_float_value(self, value_str):
        value_str = value_str.strip()
        if value_str == '' or value_str == '0':
            return None
        else:
            try:
                return float(value_str)
            except ValueError:
                return None

    def browse_folder(self):
        folder_selected = filedialog.askdirectory()
        if folder_selected:
            self.input_folder = folder_selected
            self.input_entry.delete(0, tk.END)
            self.input_entry.insert(0, self.input_folder)
            # Enable the exclude proteins checkbox
            self.exclude_proteins_checkbox.config(state=tk.NORMAL)

    def exclude_proteins_checked(self):
        if self.exclude_proteins_var.get():
            # The checkbox is checked, reset the flag and open the new window
            self.proteins_to_exclude_set = False
            self.open_protein_selection_window()
        else:
            # The checkbox is unchecked, clear the exclude list and reset the flag
            self.proteins_to_exclude = []
            self.proteins_to_exclude_set = False
            # Reset the label color to default
            self.exclude_proteins_label.config(fg='black')

    def open_protein_selection_window(self):
        # Read all 'protein.Entry' values from IA_final_peptide.csv files

        # Get all IA_final_peptide.csv files
        ia_files = []
        for root, dirs, files in os.walk(self.input_folder):
            for file in files:
                if file.endswith('IA_final_peptide.csv'):
                    ia_files.append(os.path.join(root, file))

        protein_entries = set()

        for file_path in ia_files:
            try:
                df = pd.read_csv(file_path, encoding='latin1')
                if 'protein.Entry' in df.columns:
                    protein_entries.update(df['protein.Entry'].dropna().unique())
            except Exception as e:
                messagebox.showerror("Error", f"Error processing {file_path}: {e}")

        if not protein_entries:
            messagebox.showinfo("Info", "No proteins found to exclude.")
            return

        # create the new window
        self.protein_window = tk.Toplevel(self.master)
        self.protein_window.title("Exclude Proteins")

        # Label
        label = tk.Label(self.protein_window, text="Select proteins to include (uncheck to exclude):")
        label.pack()

        # Scrollable frame to hold the checkboxes
        canvas = tk.Canvas(self.protein_window)
        scrollbar = tk.Scrollbar(self.protein_window, orient="vertical", command=canvas.yview)
        scrollable_frame = tk.Frame(canvas)

        scrollable_frame.bind(
            "<Configure>",
            lambda e: canvas.configure(
                scrollregion=canvas.bbox("all")
            )
        )

        canvas.create_window((0, 0), window=scrollable_frame, anchor="nw")
        canvas.configure(yscrollcommand=scrollbar.set)

        canvas.pack(side="left", fill="both", expand=True)
        scrollbar.pack(side="right", fill="y")

        # For each protein entry, create a checkbox
        self.protein_vars = {}
        for protein in sorted(protein_entries):
            var = tk.IntVar(value=1)  # Checked by default
            chk = tk.Checkbutton(scrollable_frame, text=protein, variable=var)
            chk.pack(anchor='w')
            self.protein_vars[protein] = var

        # OK button to confirm selection
        ok_button = tk.Button(self.protein_window, text="OK", command=self.on_protein_selection_ok)
        ok_button.pack()

    def on_protein_selection_ok(self):
        # Collect the proteins to exclude
        self.proteins_to_exclude = [protein for protein, var in self.protein_vars.items() if var.get() == 0]
        self.proteins_to_exclude_set = True

        # Change the label color
        if self.proteins_to_exclude:
            self.exclude_proteins_label.config(fg='green')
        else:
            self.exclude_proteins_label.config(fg='black')

        # Close the window
        self.protein_window.destroy()

    def process_files(self):
        self.input_folder = self.input_entry.get()
        if not os.path.isdir(self.input_folder):
            messagebox.showerror("Error", "Invalid input folder selected.")
            return

        # If exclude proteins is checked but proteins not set, open the selection window
        if self.exclude_proteins_var.get():
            if not self.proteins_to_exclude_set:
                self.open_protein_selection_window()
                self.master.wait_window(self.protein_window)

        # Get filtering parameters
        sample_replicate_threshold = self.get_int_value(self.sample_replicate_threshold_entry.get())
        min_product_aa = self.get_float_value(self.min_product_aa_entry.get())
        precursor_inten = self.get_float_value(self.precursor_inten_entry.get())
        min_peptide_length = self.get_int_value(self.min_peptide_length_entry.get())
        max_peptide_length = self.get_int_value(self.max_peptide_length_entry.get())
        min_matched_products = self.get_int_value(self.min_matched_products_entry.get())
        min_consec_matched_products = self.get_int_value(self.min_consec_matched_products_entry.get())
        min_matched_products_inten = self.get_float_value(self.min_matched_products_inten_entry.get())
        min_peptide_score = self.get_float_value(self.min_peptide_score_entry.get())
        min_delta_mhp_ppm = self.get_float_value(self.min_delta_mhp_ppm_entry.get())
        max_delta_mhp_ppm = self.get_float_value(self.max_delta_mhp_ppm_entry.get())
        retention_time_rsd = self.get_float_value(self.std_deviation_entry.get())

        # Clear output area
        self.output_text.delete(1.0, tk.END)

        # Use temp directory for intermediate files
        with tempfile.TemporaryDirectory() as temp_folder:
            # Step 1: Rename and copy files
            self.output_text.insert(tk.END, "Renaming and copying files...\n")
            renamed_files = rename_csv_files(self.input_folder, temp_folder)
            if not renamed_files:
                self.output_text.insert(tk.END, "No files found to process after renaming.\n")
                return

            # Step 2: Group files based on separation time and trendline
            file_groups = self.group_files_by_separation_time_and_trendline(temp_folder)

            # Step 3: Process each group separately
            group_dfs = []
            for group_name, files in file_groups.items():
                self.output_text.insert(tk.END, f"\nProcessing group: {group_name}\n")

                # List the files being merged
                self.output_text.insert(tk.END, "Merging the following files:\n")
                for file_path in files:
                    self.output_text.insert(tk.END, f"  {os.path.basename(file_path)}\n")

                group_df = self.process_group(files, group_name, sample_replicate_threshold, retention_time_rsd)
                if not group_df.empty:
                    group_dfs.append(group_df)
                else:
                    self.output_text.insert(tk.END, f"No data left after processing group: {group_name}\n")

            # Step 4: Merge all group DataFrames
            if group_dfs:
                merged_df = pd.concat(group_dfs, ignore_index=True)
                self.output_text.insert(
                    tk.END,
                    f"\nTotal peptides after merging all groups: {merged_df.shape[0]} ({merged_df['peptide.seq'].nunique()} unique)\n"
                )
            else:
                self.output_text.insert(tk.END, "No data left after processing all groups.\n")
                return

            # Step 5: Apply remaining filters to merged data
            merged_df = self.apply_remaining_filters(
                merged_df,
                min_product_aa,
                precursor_inten,
                min_peptide_length,
                max_peptide_length,
                min_matched_products,
                min_consec_matched_products,
                min_matched_products_inten,
                min_peptide_score,
                min_delta_mhp_ppm,
                max_delta_mhp_ppm
            )

            if merged_df.empty:
                self.output_text.insert(tk.END, "No data left after applying filters.\n")
                return

            # Step 6: finalize DataFrame
            merged_df = merged_df.sort_values(by='peptide.score', ascending=False)
            merged_df = merged_df.drop_duplicates(subset='peptide.seq', keep='first')

            self.output_text.insert(
                tk.END,
                f"Final peptides after sorting and deduplication: {merged_df.shape[0]} ({merged_df['peptide.seq'].nunique()} unique)\n"
            )

            # Save the merged_df to file
            parent_directory = os.path.dirname(self.input_folder)
            output_folder = os.path.join(parent_directory, "Merged_final_peptide_excel_sheets")
            os.makedirs(output_folder, exist_ok=True)

            # Generate filename inc timestamp, ending with 'IA_final_peptide.csv'
            timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
            output_filename = f"{timestamp}_IA_final_peptide.csv"
            output_path = os.path.join(output_folder, output_filename)

            # Save the merged_df to the output_path
            merged_df.to_csv(output_path, index=False)
            self.output_text.insert(tk.END, f"\nFinal result saved to: {output_path}\n")

            messagebox.showinfo("Success", f"Processing completed. Final result saved to: {output_path}")

            # No need to delete the temporary folder; it is automatically deleted when exiting the 'with' block!

        # Reset variables to allow re-processing
        self.proteins_to_exclude = []
        self.proteins_to_exclude_set = False
        self.exclude_proteins_var.set(0)
        self.exclude_proteins_checkbox.config(state=tk.DISABLED)
        self.exclude_proteins_label.config(fg='black')

    def group_files_by_separation_time_and_trendline(self, folder_path):
        file_groups = {}
        for file in os.listdir(folder_path):
            if file.endswith(".csv"):
                file_path = os.path.join(folder_path, file)
                file_name_without_ext = os.path.splitext(file)[0]
                parts = file_name_without_ext.split('_')
                if len(parts) >= 3:
                    group_key = '_'.join(parts[:3])  # Use the first 3 parts for grouping
                    if group_key not in file_groups:
                        file_groups[group_key] = []
                    file_groups[group_key].append(file_path)
                else:
                    self.output_text.insert(tk.END, f"Skipping file with unexpected name format: {file}\n")
        return file_groups

    def process_group(self, files, group_name, sample_replicate_threshold, retention_time_rsd):
        # Read all files in the group into a DataFrame
        group_df = pd.DataFrame()
        for file_path in files:
            try:
                df = pd.read_csv(file_path, encoding='latin1')
                if df.empty:
                    self.output_text.insert(tk.END, f"File '{file_path}' is empty, skipping.\n")
                    continue
                # Ensure 'peptide.score' is numeric, convert non-numeric to NaN
                df['peptide.score'] = pd.to_numeric(df['peptide.score'], errors='coerce')
                group_df = pd.concat([group_df, df], ignore_index=True)
            except Exception as e:
                self.output_text.insert(tk.END, f"Error reading file '{file_path}': {e}\n")

        if group_df.empty:
            self.output_text.insert(tk.END, f"No data found in group: {group_name}\n")
            return group_df

        # Output the number of peptides before filtering so people can see the process
        total_peptides = group_df.shape[0]
        unique_peptides = group_df['peptide.seq'].nunique()
        self.output_text.insert(
            tk.END,
            f"Total peptides before filtering in group {group_name}: {total_peptides} ({unique_peptides} unique)\n"
        )

        # Remove peptides with peptide.score <= 0 or NaN
        group_df = group_df[group_df['peptide.score'].notna() & (group_df['peptide.score'] > 0)]

        if group_df.empty:
            self.output_text.insert(
                tk.END,
                f"No data left after removing peptides with score <= 0 in group: {group_name}\n"
            )
            return group_df

        # Exclude proteins if any
        if self.proteins_to_exclude:
            group_df = group_df[~group_df['protein.Entry'].isin(self.proteins_to_exclude)]
            if group_df.empty:
                self.output_text.insert(
                    tk.END,
                    f"No data left after protein exclusion in group: {group_name}\n"
                )
                return group_df

        # Averaging out numerical columns
        numeric_columns = [
            'peptide.MatchedProducts',
            'peptide.seqLength',
            'precursor.inten',
            'peptide.score',
            'peptide.MatchedProductsSumInten',
            'peptidePrecursor.deltaMhpPPM',
            'peptide.ConsectiveMatchedProducts'
        ]
        for col in numeric_columns:
            if col in group_df.columns:
                group_df[f'avg_{col}'] = group_df.groupby('peptide.seq')[col].transform('mean')

        # Apply sample replicate threshold within the group
        if sample_replicate_threshold is not None:
            peptide_counts = group_df.groupby('peptide.seq')['peptide.seq'].transform('count')
            group_df = group_df[peptide_counts >= sample_replicate_threshold]
            self.output_text.insert(
                tk.END,
                f"Peptides after sample replicate threshold in group {group_name}: {group_df.shape[0]} ({group_df['peptide.seq'].nunique()} unique)\n"
            )
        else:
            self.output_text.insert(
                tk.END,
                f"Skipping sample replicate threshold in group {group_name} (parameter not set or zero).\n"
            )

        if group_df.empty:
            self.output_text.insert(
                tk.END,
                f"No data left after applying sample replicate threshold in group: {group_name}\n"
            )
            return group_df

        # Apply retention time RSD within the group
        if (sample_replicate_threshold is not None and sample_replicate_threshold >= 3 and
                retention_time_rsd is not None):
            grouped_df = group_df.groupby('peptide.seq')

            for peptide_seq, group_df_inner in grouped_df:
                average = group_df_inner['precursor.retT'].mean()
                deviations = (group_df_inner['precursor.retT'] - average) ** 2
                sum_squared_results = deviations.sum()
                num_datapoints = group_df_inner.shape[0]

                if num_datapoints > 0:
                    variance = sum_squared_results / num_datapoints
                    standard_deviation = variance ** 0.5
                    relative_standard_deviation = (standard_deviation * 100) / average if average != 0 else 0

                    # Truncate RSD to one decimal place without rounding
                    truncated_rsd = int(relative_standard_deviation * 10) / 10.0

                    # Update DataFrame with truncated RSD
                    group_df.loc[group_df_inner.index, 'relative SD'] = truncated_rsd

            # Apply retention time RSD threshold
            group_df = group_df[group_df['relative SD'] <= retention_time_rsd]
            self.output_text.insert(
                tk.END,
                f"Peptides after retention time RSD threshold in group {group_name}: {group_df.shape[0]} ({group_df['peptide.seq'].nunique()} unique)\n"
            )
        else:
            self.output_text.insert(
                tk.END,
                f"Skipping retention time RSD calculation in group {group_name} (sample replicate threshold < 3 or parameter not set or zero).\n"
            )

        if group_df.empty:
            self.output_text.insert(
                tk.END,
                f"No data left after applying retention time RSD in group: {group_name}\n"
            )
            return group_df

        return group_df

    def apply_remaining_filters(self, df, min_product_aa, precursor_inten, min_peptide_length,
                                max_peptide_length, min_matched_products, min_consec_matched_products,
                                min_matched_products_inten, min_peptide_score, min_delta_mhp_ppm,
                                max_delta_mhp_ppm):
        # Apply other filters based on the averaged-out values

        # Score Filter
        if min_peptide_score is not None:
            df = df[df['avg_peptide.score'] >= min_peptide_score]
            self.output_text.insert(
                tk.END,
                f"Peptides after score filter: {df.shape[0]} ({df['peptide.seq'].nunique()} unique)\n"
            )
        else:
            self.output_text.insert(tk.END, "Skipping score filter (parameter not set or zero).\n")

        if df.empty:
            return df

        # Products per Amino Acid Filter
        if min_product_aa is not None:
            # Apply truncation logic to the average number of products per amino acid to 2 decimal places
            rounded_products = df['avg_peptide.MatchedProducts'].round()
            truncated_product_aa = (rounded_products / df['avg_peptide.seqLength']).apply(
                lambda x: int(x * 100) / 100.0
            )
            df = df[truncated_product_aa >= min_product_aa]
            self.output_text.insert(
                tk.END,
                f"Peptides after products per amino acid filter: {df.shape[0]} ({df['peptide.seq'].nunique()} unique)\n"
            )
        else:
            self.output_text.insert(tk.END, "Skipping products per amino acid filter (parameter not set or zero).\n")

        if df.empty:
            return df

        # Intensity Filter
        if precursor_inten is not None:
            df = df[df['avg_precursor.inten'] >= precursor_inten]
            self.output_text.insert(
                tk.END,
                f"Peptides after intensity filter: {df.shape[0]} ({df['peptide.seq'].nunique()} unique)\n"
            )
        else:
            self.output_text.insert(tk.END, "Skipping intensity filter (parameter not set or zero).\n")

        if df.empty:
            return df

        # Sequence Length Filter
        if ((min_peptide_length is not None) or (max_peptide_length is not None)):
            if min_peptide_length is not None and max_peptide_length is not None:
                df = df[
                    (df['avg_peptide.seqLength'] >= min_peptide_length) &
                    (df['avg_peptide.seqLength'] <= max_peptide_length)
                ]
            elif min_peptide_length is not None:
                df = df[df['avg_peptide.seqLength'] >= min_peptide_length]
            elif max_peptide_length is not None:
                df = df[df['avg_peptide.seqLength'] <= max_peptide_length]
            self.output_text.insert(
                tk.END,
                f"Peptides after sequence length filter: {df.shape[0]} ({df['peptide.seq'].nunique()} unique)\n"
            )
        else:
            self.output_text.insert(tk.END, "Skipping sequence length filter (parameters not set or zero).\n")

        if df.empty:
            return df

        # Matched Products Filter
        if min_matched_products is not None:
            # Round the averaged matched products to nearest integer
            rounded_matched_products = df['avg_peptide.MatchedProducts'].round()
            df = df[rounded_matched_products >= min_matched_products]
            self.output_text.insert(
                tk.END,
                f"Peptides after matched products filter: {df.shape[0]} ({df['peptide.seq'].nunique()} unique)\n"
            )
        else:
            self.output_text.insert(tk.END, "Skipping matched products filter (parameter not set or zero).\n")

        if df.empty:
            return df

        # Consecutive Products Filter
        if min_consec_matched_products is not None:
            # Round the averaged consecutive matched products to nearest integer
            rounded_consec_products = df['avg_peptide.ConsectiveMatchedProducts'].round()
            df = df[rounded_consec_products >= min_consec_matched_products]
            self.output_text.insert(
                tk.END,
                f"Peptides after consecutive products filter: {df.shape[0]} ({df['peptide.seq'].nunique()} unique)\n"
            )
        else:
            self.output_text.insert(
                tk.END,
                "Skipping consecutive products filter (parameter not set or zero).\n"
            )

        if df.empty:
            return df

        # Sum Intensity for Products Filter
        if min_matched_products_inten is not None:
            df = df[df['avg_peptide.MatchedProductsSumInten'] >= min_matched_products_inten]
            self.output_text.insert(
                tk.END,
                f"Peptides after sum intensity for products filter: {df.shape[0]} ({df['peptide.seq'].nunique()} unique)\n"
            )
        else:
            self.output_text.insert(
                tk.END,
                "Skipping sum intensity for products filter (parameter not set or zero).\n"
            )

        if df.empty:
            return df

        # Mass Error Filter
        if ((min_delta_mhp_ppm is not None) or (max_delta_mhp_ppm is not None)):
            if min_delta_mhp_ppm is not None and max_delta_mhp_ppm is not None:
                df = df[
                    (df['avg_peptidePrecursor.deltaMhpPPM'] >= min_delta_mhp_ppm) &
                    (df['avg_peptidePrecursor.deltaMhpPPM'] <= max_delta_mhp_ppm)
                ]
            elif min_delta_mhp_ppm is not None:
                df = df[df['avg_peptidePrecursor.deltaMhpPPM'] >= min_delta_mhp_ppm]
            elif max_delta_mhp_ppm is not None:
                df = df[df['avg_peptidePrecursor.deltaMhpPPM'] <= max_delta_mhp_ppm]
            self.output_text.insert(
                tk.END,
                f"Peptides after mass error filter: {df.shape[0]} ({df['peptide.seq'].nunique()} unique)\n"
            )
        else:
            self.output_text.insert(tk.END, "Skipping mass error filter (parameters not set or zero).\n")

        if df.empty:
            return df

        # Remove extra averaged-out columns
        numeric_columns = [
            'peptide.MatchedProducts',
            'peptide.seqLength',
            'precursor.inten',
            'peptide.score',
            'peptide.MatchedProductsSumInten',
            'peptidePrecursor.deltaMhpPPM',
            'peptide.ConsectiveMatchedProducts'
        ]
        df = df.drop(
            columns=[f'avg_{col}' for col in numeric_columns if f'avg_{col}' in df.columns],
            errors='ignore'
        )

        # Remove 'relative SD' column if it exists
        if 'relative SD' in df.columns:
            df = df.drop(columns=['relative SD'])

        return df

def main():
    root = tk.Tk()
    app = TrendlineAnalyzerApp(root)
    root.mainloop()

if __name__ == "__main__":
    main()
