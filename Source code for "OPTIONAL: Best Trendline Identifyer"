import os
import pandas as pd
import tkinter as tk
from tkinter import filedialog, messagebox
from datetime import datetime

class TrendlineAnalyzerApp:
    def __init__(self, master):
        self.master = master
        master.title("Trendline Analyzer with Filtering Parameters")

        self.input_folder = ''
        self.results = ''
        self.best_trendline_data = None  # Store data of the best trendline
        self.proteins_to_exclude = []    # List of proteins to exclude
        self.proteins_to_exclude_set = False  # Flag to check if selection is made
        self.separation_time = None  # store selected separation time
        self.separation_time_set = False  # Flag to check if selection is made
        self.check_vars = {}  # Store checkbox variables for separation times

        # Create GUI widgets
        self.create_widgets()

    def create_widgets(self):
        # Define 2 column layout
        left_frame = tk.Frame(self.master)
        left_frame.grid(row=0, column=0, padx=10, pady=10, sticky='nw')

        right_frame = tk.Frame(self.master)
        right_frame.grid(row=0, column=1, padx=10, pady=10, sticky='ne')

        # header label
        self.header_label = tk.Label(
            left_frame,
            text="The best performing trendline will appear here",
            font=("Arial", 16),
            fg="black"
        )
        self.header_label.grid(row=0, column=0, columnspan=3, padx=10, pady=10)

        # Input folder section
        self.input_label = tk.Label(left_frame, text="Select Input Folder:")
        self.input_label.grid(row=1, column=0, padx=5, pady=5, sticky='e')

        self.input_entry = tk.Entry(left_frame, width=45)
        self.input_entry.grid(row=1, column=1, padx=5, pady=5, sticky='w')

        self.browse_button = tk.Button(left_frame, text="Browse", command=self.browse_folder)
        self.browse_button.grid(row=1, column=2, padx=0, pady=5, sticky='w')

        # Output text area
        self.output_text = tk.Text(left_frame, width=80, height=20)
        self.output_text.grid(row=2, column=0, columnspan=2, padx=10, pady=10)

        # scrollbar 
        self.scrollbar = tk.Scrollbar(left_frame, command=self.output_text.yview, width=12)
        self.scrollbar.grid(row=2, column=2, sticky='ns')
        self.output_text['yscrollcommand'] = self.scrollbar.set


        # Separation time selection label
        self.separation_time_label = tk.Label(
            right_frame,
            text="IM-MS separation time chosen for analysis: None",
            fg="black",
            cursor="hand2"
        )
        self.separation_time_label.grid(row=0, column=0, columnspan=2, padx=10, pady=5, sticky='w')
        self.separation_time_label.bind("<Button-1>", lambda e: self.open_separation_time_selection_window())

        # Exclude protein (if wanted) checkbox 
        self.exclude_proteins_frame = tk.Frame(right_frame)
        self.exclude_proteins_frame.grid(row=1, column=0, columnspan=2, padx=10, pady=5, sticky='w')

        self.exclude_proteins_var = tk.IntVar()
        self.exclude_proteins_checkbox = tk.Checkbutton(
            self.exclude_proteins_frame,
            variable=self.exclude_proteins_var,
            state=tk.DISABLED,
            command=self.exclude_proteins_checked
        )
        self.exclude_proteins_checkbox.pack(side='left')

        self.exclude_proteins_label = tk.Label(
            self.exclude_proteins_frame,
            text="Exclude proteins..."
        )
        self.exclude_proteins_label.pack(side='left')

        self.create_filtering_fields(right_frame)

        # Process button 
        self.process_button = tk.Button(
            right_frame,
            text="Process Trendlines",
            command=self.process_trendlines
        )
        self.process_button.grid(row=16, column=1, padx=10, pady=20)

    def create_filtering_fields(self, parent):
        # Filtering parameters...
        self.label_and_entry(parent, "Sample replicate threshold:", "3", 2, 0)
        self.sample_replicate_threshold_entry = self.entry

        self.label_and_entry(parent, "Min. products per amino acid:", "0.11", 3, 0)
        self.min_product_aa_entry = self.entry

        self.label_and_entry(parent, "Min. intensity:", "1000", 4, 0)
        self.precursor_inten_entry = self.entry

        self.label_and_entry(parent, "Min. sequence length:", "5", 5, 0)
        self.min_peptide_length_entry = self.entry

        self.label_and_entry(parent, "Max. sequence length:", "30", 6, 0)
        self.max_peptide_length_entry = self.entry

        self.label_and_entry(parent, "Min. products:", "2", 7, 0)
        self.min_matched_products_entry = self.entry

        self.label_and_entry(parent, "Min. consecutive products:", "1", 8, 0)
        self.min_consec_matched_products_entry = self.entry

        self.label_and_entry(parent, "Min. sum intensity for products:", "472", 9, 0)
        self.min_matched_products_inten_entry = self.entry

        self.label_and_entry(parent, "Min. score:", "6.62", 10, 0)
        self.min_peptide_score_entry = self.entry

        self.label_and_entry(parent, "Min. MH+ error (ppm):", "-5", 11, 0)
        self.min_delta_mhp_ppm_entry = self.entry

        self.label_and_entry(parent, "Max. MH+ error (ppm):", "5", 12, 0)
        self.max_delta_mhp_ppm_entry = self.entry

        self.label_and_entry(parent, "Retention time RSD:", "4", 13, 0)
        self.std_deviation_entry = self.entry

    def label_and_entry(self, parent, label_text, default_value, row, column):
        label = tk.Label(parent, text=label_text)
        label.grid(row=row, column=column, padx=10, pady=5, sticky='e')
        self.entry = tk.Entry(parent, width=15)
        self.entry.insert(0, default_value)
        self.entry.grid(row=row, column=column + 1, padx=10, pady=5, sticky='w')

    def get_int_value(self, value_str):
        value_str = value_str.strip()
        return int(value_str) if value_str and int(value_str) != 0 else None

    def get_float_value(self, value_str):
        value_str = value_str.strip()
        return float(value_str) if value_str and float(value_str) != 0 else None

    def browse_folder(self):
        folder_selected = filedialog.askdirectory()
        if folder_selected:
            self.input_folder = folder_selected
            self.input_entry.delete(0, tk.END)
            self.input_entry.insert(0, self.input_folder)
            # Enable checkbox
            self.exclude_proteins_checkbox.config(state=tk.NORMAL)
            # Open extra window
            self.open_separation_time_selection_window()

    def open_separation_time_selection_window(self):
        # scan subfolders for IA_final_peptide files
        separation_times = set()

        # get the subfolders
        subfolders = [os.path.join(self.input_folder, o) for o in os.listdir(self.input_folder)
                      if os.path.isdir(os.path.join(self.input_folder, o))]

        # If no subfolders found, include the input folder itself
        if not subfolders:
            subfolders = [self.input_folder]

        # Dictionary to hold mapping from separation time to subfolder to files
        self.separation_time_files = {}

        for subfolder in subfolders:
            subfolder_name = os.path.basename(subfolder)
            # Find IA_final_peptide files
            for root, dirs, files in os.walk(subfolder):
                for file in files:
                    if file.endswith('IA_final_peptide.csv'):
                        file_path = os.path.join(root, file)
                        # Extract separation time from filename
                        filename = os.path.basename(file_path)
                        parts = filename.split('_')
                        file_sep_time = None
                        for part in parts:
                            if part.endswith('ms'):
                                file_sep_time = part
                                break
                        if file_sep_time:
                            separation_times.add(file_sep_time)
                        else:
                            # If no separation time in filename
                            if '1_1' in root or '1_1' in subfolder:
                                separation_times.add('single-pass')
                                file_sep_time = 'single-pass'
                            else:
                                # If no separation time, and not in '1_1', bring a warning
                                messagebox.showwarning("Attention", "No IM-MS separation times found in file name.")
                                return  # Do not proceed further
                        # Store file under separation time and subfolder
                        if file_sep_time not in self.separation_time_files:
                            self.separation_time_files[file_sep_time] = {}
                        if subfolder_name not in self.separation_time_files[file_sep_time]:
                            self.separation_time_files[file_sep_time][subfolder_name] = []
                        self.separation_time_files[file_sep_time][subfolder_name].append(file_path)

        if not separation_times:
            messagebox.showinfo("Info", "No separation times found.")
            return

        # selection window
        self.separation_window = tk.Toplevel(self.master)
        self.separation_window.title("Select IM-MS Separation Time")

        # Label 
        label = tk.Label(self.separation_window, text="Select for which IM-MS separation you want to find the best trendline in your data:")
        label.pack()

        # Checkboxes for each separation time
        self.check_vars.clear()  # Clear previous checkbox variables
        for sep_time in sorted(separation_times):
            var = tk.IntVar(value=0)  # Not selected by default
            cb = tk.Checkbutton(self.separation_window, text=sep_time, variable=var,
                                command=lambda v=var: self.on_checkbox_selected(v))
            cb.pack(anchor='w')
            self.check_vars[sep_time] = var

        # OK button 
        ok_button = tk.Button(self.separation_window, text="OK", command=self.on_separation_time_selection_ok)
        ok_button.pack()

    def on_checkbox_selected(self, selected_var):
        # Disable all checkboxes except the selected one
        for var in self.check_vars.values():
            if var != selected_var:
                var.set(0)

    def on_separation_time_selection_ok(self):
        selected_time = None
        for sep_time, var in self.check_vars.items():
            if var.get() == 1:
                selected_time = sep_time
                break

        if not selected_time:
            messagebox.showwarning("Warning", "Please select a separation time.")
            return

        self.separation_time = selected_time
        self.separation_time_set = True
        # Update label
        self.separation_time_label.config(
            text=f"IM-MS separation time chosen for analysis: {self.separation_time}",
            fg='green'
        )
        # Close window
        self.separation_window.destroy()

    def exclude_proteins_checked(self):
        if self.exclude_proteins_var.get():
            # The checkbox is checked, reset the flag/open new window
            self.proteins_to_exclude_set = False
            self.open_protein_selection_window()
        else:
            # The checkbox is unchecked, clear the exclude list and reset the flag
            self.proteins_to_exclude = []
            self.proteins_to_exclude_set = False
            # Reset the label color to default
            self.exclude_proteins_label.config(fg='black')

    def open_protein_selection_window(self):
        # Read protein.Entry values in IA_final_peptide.csv files

        # Get sub folders
        subfolders = [os.path.join(self.input_folder, o) for o in os.listdir(self.input_folder)
                      if os.path.isdir(os.path.join(self.input_folder, o))]

        # If no subfolders found, inc. input folder
        if not subfolders:
            subfolders = [self.input_folder]

        protein_entries = set()

        for subfolder in subfolders:
            # Find and process all IA_final_peptide.csv files in the subfolder
            ia_files = []
            for root, dirs, files in os.walk(subfolder):
                for file in files:
                    if file.endswith('IA_final_peptide.csv'):
                        ia_files.append(os.path.join(root, file))

            for file_path in ia_files:
                try:
                    df = pd.read_csv(file_path, encoding='latin1')
                    if 'protein.Entry' in df.columns:
                        protein_entries.update(df['protein.Entry'].dropna().unique())
                except Exception as e:
                    messagebox.showerror("Error", f"Error processing {file_path}: {e}")

        if not protein_entries:
            messagebox.showinfo("Info", "No proteins found to exclude.")
            return

        # Now create the new window
        self.protein_window = tk.Toplevel(self.master)
        self.protein_window.title("Exclude Proteins")

        # Label at the top
        label = tk.Label(self.protein_window, text="These proteins were found in the input folders:")
        label.pack()

        # Scrollable frame to hold the checkboxes
        canvas = tk.Canvas(self.protein_window)
        scrollbar = tk.Scrollbar(self.protein_window, orient="vertical", command=canvas.yview)
        scrollable_frame = tk.Frame(canvas)

        scrollable_frame.bind(
            "<Configure>",
            lambda e: canvas.configure(
                scrollregion=canvas.bbox("all")
            )
        )

        canvas.create_window((0, 0), window=scrollable_frame, anchor="nw")
        canvas.configure(yscrollcommand=scrollbar.set)

        canvas.pack(side="left", fill="both", expand=True)
        scrollbar.pack(side="right", fill="y")

        # For each protein entry, create checkbox
        self.protein_vars = {}
        for protein in sorted(protein_entries):
            var = tk.IntVar(value=1)  # Checked by default!
            chk = tk.Checkbutton(scrollable_frame, text=protein, variable=var)
            chk.pack(anchor='w')
            self.protein_vars[protein] = var

        # OK button 
        ok_button = tk.Button(self.protein_window, text="OK", command=self.on_protein_selection_ok)
        ok_button.pack()

    def on_protein_selection_ok(self):
        # Collect proteins to exclude
        self.proteins_to_exclude = [protein for protein, var in self.protein_vars.items() if var.get() == 0]
        self.proteins_to_exclude_set = True

        # Make label green to show to people that it works
        if self.proteins_to_exclude:
            self.exclude_proteins_label.config(fg='green')
        else:
            self.exclude_proteins_label.config(fg='black')

        # Close window
        self.protein_window.destroy()

    def process_trendlines(self):
        self.input_folder = self.input_entry.get()
        if not os.path.isdir(self.input_folder):
            messagebox.showerror("Error", "Invalid input folder selected.")
            return

        # If exclude proteins is checked but proteins not set, open the selection window
        if self.exclude_proteins_var.get():
            if not self.proteins_to_exclude_set:
                self.open_protein_selection_window()
                self.master.wait_window(self.protein_window)

        # If separation time not set, ask user to select
        if not self.separation_time_set:
            messagebox.showwarning("Warning", "Please select an IM-MS separation time for analysis.")
            return

        # Get filtering parameters
        sample_replicate_threshold = self.get_int_value(self.sample_replicate_threshold_entry.get())
        min_product_aa = self.get_float_value(self.min_product_aa_entry.get())
        precursor_inten = self.get_float_value(self.precursor_inten_entry.get())
        min_peptide_length = self.get_float_value(self.min_peptide_length_entry.get())
        max_peptide_length = self.get_float_value(self.max_peptide_length_entry.get())
        min_matched_products = self.get_float_value(self.min_matched_products_entry.get())
        min_consec_matched_products = self.get_float_value(self.min_consec_matched_products_entry.get())
        min_matched_products_inten = self.get_float_value(self.min_matched_products_inten_entry.get())
        min_peptide_score = self.get_float_value(self.min_peptide_score_entry.get())
        min_delta_mhp_ppm = self.get_float_value(self.min_delta_mhp_ppm_entry.get())
        max_delta_mhp_ppm = self.get_float_value(self.max_delta_mhp_ppm_entry.get())
        retention_time_rsd = self.get_float_value(self.std_deviation_entry.get())

        # Clear output area
        self.output_text.delete(1.0, tk.END)

        if self.separation_time not in self.separation_time_files:
            messagebox.showerror("Error", f"No files found for separation time {self.separation_time}.")
            return

        counts_per_subfolder = {}
        max_unique_peptides = 0
        best_subfolder = None
        best_df = None

        for subfolder_name in self.separation_time_files[self.separation_time]:
            ia_files = self.separation_time_files[self.separation_time][subfolder_name]
            self.output_text.insert(tk.END, f"\nProcessing trendline: {subfolder_name}\n")
            merged_df = pd.DataFrame()
            for file_path in ia_files:
                self.output_text.insert(tk.END, f"Processing file: {file_path}\n")
                try:
                    df = pd.read_csv(file_path, encoding='latin1')
                    merged_df = pd.concat([merged_df, df], ignore_index=True)
                except Exception as e:
                    self.output_text.insert(tk.END, f"Error processing {file_path}: {e}\n")

            # Ensure 'peptide.score' is numeric, else convert to NaN
            merged_df['peptide.score'] = pd.to_numeric(merged_df['peptide.score'], errors='coerce')

            # Report counts before filtering so people know them
            total_peptides = merged_df.shape[0]
            total_unique_peptides = merged_df['peptide.seq'].nunique()
            self.output_text.insert(
                tk.END,
                f"Total peptides before any filtering: {total_peptides} ({total_unique_peptides} unique)\n"
            )

            # Count peptides with score <= 0
            num_non_positive_scores = (merged_df['peptide.score'] <= 0).sum()
            self.output_text.insert(tk.END, f"Number of peptides with score <= 0: {num_non_positive_scores}\n")

            # Remove peptides with peptide.score <= 0 or NaN
            merged_df = merged_df[merged_df['peptide.score'].notna() & (merged_df['peptide.score'] > 0)]

            # Report counts after removing peptides score <= 0
            after_score_filter_total_peptides = merged_df.shape[0]
            after_score_filter_unique_peptides = merged_df['peptide.seq'].nunique()
            self.output_text.insert(
                tk.END,
                f"Total peptides after removing peptides with score <= 0: {after_score_filter_total_peptides} ({after_score_filter_unique_peptides} unique)\n"
            )

            if merged_df.empty:
                self.output_text.insert(tk.END, "No data to process in this trendline.\n")
                counts_per_subfolder[subfolder_name] = 0
                continue

            # exclude proteins
            if self.proteins_to_exclude:
                initial_count = merged_df.shape[0]
                merged_df = merged_df[~merged_df['protein.Entry'].isin(self.proteins_to_exclude)]
                excluded_count = initial_count - merged_df.shape[0]
                self.output_text.insert(tk.END, f"Excluded {excluded_count} peptides based on protein exclusion.\n")

                if merged_df.empty:
                    self.output_text.insert(tk.END, "No data left after protein exclusion.\n")
                    counts_per_subfolder[subfolder_name] = 0
                    continue

            # Step 2: Avrg numerical columns (where matching)
            numeric_columns = [
                'peptide.MatchedProducts',
                'peptide.seqLength',
                'precursor.inten',
                'peptide.score',
                'peptide.MatchedProductsSumInten',
                'peptidePrecursor.deltaMhpPPM',
                'peptide.ConsectiveMatchedProducts'
            ]
            for col in numeric_columns:
                if col in merged_df.columns:
                    merged_df[f'avg_{col}'] = merged_df.groupby('peptide.seq')[col].transform('mean')

            self.output_text.insert(tk.END, f"Averaged out numerical values added.\n")

            # step3: Apply file threshold/sample replicate threshold
            if sample_replicate_threshold is not None:
                peptide_counts = merged_df.groupby('peptide.seq')['peptide.seq'].transform('count')
                merged_df = merged_df[peptide_counts >= sample_replicate_threshold]
                self.output_text.insert(
                    tk.END,
                    f"Peptides after file threshold: {merged_df.shape[0]} ({merged_df['peptide.seq'].nunique()} unique)\n"
                )
            else:
                self.output_text.insert(tk.END, "Skipping file threshold (sample replicate threshold not set).\n")

            # Step 4: Apply retention time RSD (if file threshold is 3 or more!!!)
            if sample_replicate_threshold is not None and sample_replicate_threshold >= 3 and retention_time_rsd is not None:
                grouped_df = merged_df.groupby('peptide.seq')

                for group_name, group_df in grouped_df:
                    average = group_df['precursor.retT'].mean()
                    deviations = (group_df['precursor.retT'] - average) ** 2
                    sum_squared_results = deviations.sum()
                    num_datapoints = group_df.shape[0]

                    if num_datapoints > 0:
                        # population std dev (not rounding)
                        squared_results_minus_datapoints = sum_squared_results / num_datapoints
                        standard_deviation = squared_results_minus_datapoints ** 0.5
                        relative_standard_deviation = (standard_deviation * 100) / average

                        # Truncate to one decimal place (no rounding)
                        relative_standard_deviation = int(relative_standard_deviation * 10) / 10.0

                        # Update DataFrame with calculated relative SD using .loc / to avoid warnings
                        merged_df.loc[group_df.index, 'relative SD'] = relative_standard_deviation

                # Apply retention time RSD 
                merged_df = merged_df[merged_df['relative SD'] <= retention_time_rsd]
                self.output_text.insert(
                    tk.END,
                    f"Peptides after retention time RSD threshold: {merged_df.shape[0]} ({merged_df['peptide.seq'].nunique()} unique)\n"
                )
            else:
                self.output_text.insert(
                    tk.END,
                    "Skipping retention time RSD calculation as file threshold is not set or < 3.\n"
                )

            # Step 5: apply other filters based on the averaged-out values
            if min_peptide_score is not None:
                merged_df = merged_df[merged_df['avg_peptide.score'] >= min_peptide_score]
                self.output_text.insert(
                    tk.END,
                    f"Peptides after score filter: {merged_df.shape[0]} ({merged_df['peptide.seq'].nunique()} unique)\n"
                )
            else:
                self.output_text.insert(tk.END, "Skipping score filter (parameter not set).\n")

            if min_product_aa is not None:
                # Apply truncation logic (2 decimal places)
                rounded_products = merged_df['avg_peptide.MatchedProducts'].round()
                truncated_product_aa = (rounded_products / merged_df['avg_peptide.seqLength']).apply(
                    lambda x: int(x * 100) / 100.0
                )
                merged_df = merged_df[truncated_product_aa >= min_product_aa]
                self.output_text.insert(
                    tk.END,
                    f"Peptides after products per amino acid filter: {merged_df.shape[0]} ({merged_df['peptide.seq'].nunique()} unique)\n"
                )
            else:
                self.output_text.insert(tk.END, "Skipping products per amino acid filter (parameter not set).\n")

            if precursor_inten is not None:
                merged_df = merged_df[merged_df['avg_precursor.inten'] >= precursor_inten]
                self.output_text.insert(
                    tk.END,
                    f"Peptides after intensity filter: {merged_df.shape[0]} ({merged_df['peptide.seq'].nunique()} unique)\n"
                )
            else:
                self.output_text.insert(tk.END, "Skipping intensity filter (parameter not set).\n")

            if min_peptide_length is not None or max_peptide_length is not None:
                if min_peptide_length is not None and max_peptide_length is not None:
                    merged_df = merged_df[
                        (merged_df['avg_peptide.seqLength'] >= min_peptide_length) &
                        (merged_df['avg_peptide.seqLength'] <= max_peptide_length)
                    ]
                elif min_peptide_length is not None:
                    merged_df = merged_df[merged_df['avg_peptide.seqLength'] >= min_peptide_length]
                elif max_peptide_length is not None:
                    merged_df = merged_df[merged_df['avg_peptide.seqLength'] <= max_peptide_length]
                self.output_text.insert(
                    tk.END,
                    f"Peptides after sequence length filter: {merged_df.shape[0]} ({merged_df['peptide.seq'].nunique()} unique)\n"
                )
            else:
                self.output_text.insert(tk.END, "Skipping sequence length filter (parameters not set).\n")

            # matched products filter based on rounded averaged values
            if min_matched_products is not None:
                # Round the averaged matched products to nearest integer
                rounded_matched_products = merged_df['avg_peptide.MatchedProducts'].round()
                merged_df = merged_df[rounded_matched_products >= min_matched_products]
                self.output_text.insert(
                    tk.END,
                    f"Peptides after matched products filter: {merged_df.shape[0]} ({merged_df['peptide.seq'].nunique()} unique)\n"
                )
            else:
                self.output_text.insert(tk.END, "Skipping matched products filter (parameter not set).\n")

            # minimum consecutive products filter based on rounded averaged values
            if min_consec_matched_products is not None:
                # averaged consecutive matched products to nearest integer
                rounded_consec_products = merged_df['avg_peptide.ConsectiveMatchedProducts'].round()
                merged_df = merged_df[rounded_consec_products >= min_consec_matched_products]
                self.output_text.insert(
                    tk.END,
                    f"Peptides after consecutive products filter: {merged_df.shape[0]} ({merged_df['peptide.seq'].nunique()} unique)\n"
                )
            else:
                self.output_text.insert(tk.END, "Skipping consecutive products filter (parameter not set).\n")

            if min_matched_products_inten is not None:
                merged_df = merged_df[merged_df['avg_peptide.MatchedProductsSumInten'] >= min_matched_products_inten]
                self.output_text.insert(
                    tk.END,
                    f"Peptides after sum intensity for products filter: {merged_df.shape[0]} ({merged_df['peptide.seq'].nunique()} unique)\n"
                )
            else:
                self.output_text.insert(tk.END, "Skipping sum intensity for products filter (parameter not set).\n")

            if min_delta_mhp_ppm is not None or max_delta_mhp_ppm is not None:
                if min_delta_mhp_ppm is not None and max_delta_mhp_ppm is not None:
                    merged_df = merged_df[
                        (merged_df['avg_peptidePrecursor.deltaMhpPPM'] >= min_delta_mhp_ppm) &
                        (merged_df['avg_peptidePrecursor.deltaMhpPPM'] <= max_delta_mhp_ppm)
                    ]
                elif min_delta_mhp_ppm is not None:
                    merged_df = merged_df[merged_df['avg_peptidePrecursor.deltaMhpPPM'] >= min_delta_mhp_ppm]
                elif max_delta_mhp_ppm is not None:
                    merged_df = merged_df[merged_df['avg_peptidePrecursor.deltaMhpPPM'] <= max_delta_mhp_ppm]
                self.output_text.insert(
                    tk.END,
                    f"Peptides after mass error filter: {merged_df.shape[0]} ({merged_df['peptide.seq'].nunique()} unique)\n"
                )
            else:
                self.output_text.insert(tk.END, "Skipping mass error filter (parameters not set).\n")

            # Step 6: Remove extra averaged columns
            merged_df = merged_df.drop(
                columns=[f'avg_{col}' for col in numeric_columns if f'avg_{col}' in merged_df.columns],
                errors='ignore'
            )

            # Step7: Sort by peptide.score, remove duplicates based on peptide.seq
            merged_df = merged_df.sort_values(by='peptide.score', ascending=False)
            merged_df = merged_df.drop_duplicates(subset='peptide.seq', keep='first')

            final_unique_peptides = merged_df['peptide.seq'].nunique()
            self.output_text.insert(
                tk.END,
                f"Final peptides after sorting and deduplication: {merged_df.shape[0]} ({final_unique_peptides} unique)\n"
            )

            counts_per_subfolder[subfolder_name] = final_unique_peptides

            if final_unique_peptides > max_unique_peptides:
                max_unique_peptides = final_unique_peptides
                best_subfolder = subfolder_name
                best_df = merged_df

            self.output_text.insert(tk.END, f"Completed processing trendline: {subfolder_name}\n")

        # After processing, summarize results
        self.output_text.insert(tk.END, "\nFinal results:\n")

        # Define custom sort key
        def sort_key(subfolder_name):
            parts = subfolder_name.split('_')
            numeric_parts = []
            for part in parts:
                # Remove leading zeros and convert to int 
                stripped_part = part.lstrip('0') or '0'
                if stripped_part.isdigit():
                    numeric_parts.append(int(stripped_part))
                else:
                    numeric_parts.append(part)
            return numeric_parts

        for subfolder_name in sorted(counts_per_subfolder.keys(), key=sort_key):
            count = counts_per_subfolder[subfolder_name]
            self.output_text.insert(tk.END, f"{subfolder_name}: {count} unique peptides\n")

        # Update header with best trendline
        if best_subfolder:
            self.header_label.config(
                text=f"The best performing trendline is {best_subfolder} with {max_unique_peptides} unique peptides"
            )
        else:
            self.header_label.config(text="No valid data found in any trendline.")

        # Save the best_df to a file
        if best_df is not None:
            parent_directory = os.path.dirname(self.input_folder)
            output_folder = os.path.join(parent_directory, "processed_results")
            os.makedirs(output_folder, exist_ok=True)

            # Generate filename with timestamp and best trendline name, ending with 'IA_final_peptide.csv'
            timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
            output_filename = f"{best_subfolder}_{timestamp}_IA_final_peptide.csv"
            output_path = os.path.join(output_folder, output_filename)

            # Save the best_df to the output_path
            best_df.to_csv(output_path, index=False)
            self.output_text.insert(tk.END, f"\nFinal result saved to: {output_path}\n")
        else:
            self.output_text.insert(tk.END, "No data to save.\n")


def main():
    root = tk.Tk()
    app = TrendlineAnalyzerApp(root)
    root.mainloop()


if __name__ == "__main__":
    main()
