    def label_and_entry(self, parent, label_text, default_value, row, column):
        label = tk.Label(parent, text=label_text)
        label.grid(row=row, column=column, padx=10, pady=5, sticky='e')
        self.entry = tk.Entry(parent, width=15)
        self.entry.insert(0, default_value)
        self.entry.grid(row=row, column=column + 1, padx=10, pady=5, sticky='w')

    def get_int_value(self, value_str):
        value_str = value_str.strip()
        if value_str == '' or value_str == '0':
            return None
        try:
            return int(value_str)
        except ValueError:
            return None

    def get_float_value(self, value_str):
        value_str = value_str.strip()
        if value_str == '' or value_str == '0':
            return None
        try:
            return float(value_str)
        except ValueError:
            return None

    def browse_folder(self):
        folder_selected = filedialog.askdirectory()
        if folder_selected:
            self.input_folder = folder_selected
            self.input_entry.delete(0, tk.END)
            self.input_entry.insert(0, self.input_folder)
            self.exclude_proteins_checkbox.config(state=tk.NORMAL)
            self.open_sample_selection_window()

    def open_sample_selection_window(self):
        sample_names = get_all_sample_names(self.input_folder)
        if not sample_names:
            messagebox.showinfo("Info", "No valid samples found in this folder.")
            return
        self.sample_window = tk.Toplevel(self.master)
        self.sample_window.title("Select Samples to Merge")
        self.sample_window.geometry("750x400")
        self.sample_window.grid_rowconfigure(2, weight=1)
        self.sample_window.grid_columnconfigure(0, weight=1)

        top_label = tk.Label(
            self.sample_window,
            text="Tick samples to include. Match replicates (number)"
        )
        top_label.grid(row=0, column=0, padx=5, pady=5, sticky='w')

        self.deselect_all_var = tk.IntVar(value=0)
        self.deselect_all_chk = tk.Checkbutton(
            self.sample_window,
            text="De-select all sample-groups",
            variable=self.deselect_all_var,
            command=self.on_deselect_all_clicked
        )
        self.deselect_all_chk.grid(row=0, column=1, padx=5, sticky='w')

        scroll_frame = tk.Frame(self.sample_window)
        scroll_frame.grid(row=2, column=0, columnspan=2, sticky='nsew', padx=5, pady=5)

        canvas = tk.Canvas(scroll_frame, width=680, height=300)
        scrollbar = tk.Scrollbar(scroll_frame, orient="vertical", command=canvas.yview)
        self.sample_frame = tk.Frame(canvas)
        self.sample_frame.bind("<Configure>", lambda e: canvas.configure(scrollregion=canvas.bbox("all")))
        canvas.create_window((0, 0), window=self.sample_frame, anchor="nw")
        canvas.configure(yscrollcommand=scrollbar.set)
        canvas.pack(side="left", fill="both", expand=True)
        scrollbar.pack(side="right", fill="y")

        self.sample_vars = {}
        self.sample_group_entries = {}

        for samp in sample_names:
            default_time = extract_separation_time(samp) or "0"
            # Decide MP/SP based on presence of <number>ms in sample name
            detected_type = "MP" if re.search(r'\d+ms', samp) else "SP"

            frame_row = tk.Frame(self.sample_frame)
            frame_row.pack(anchor='w', fill='x', pady=2)

            var = tk.IntVar(value=1)
            chk = tk.Checkbutton(frame_row, text=samp, variable=var, width=70, anchor='w')
            chk.pack(side='left')

            entry = tk.Entry(frame_row, width=10)
            entry.insert(0, default_time)
            entry.pack(side='left', padx=10)

            # Extra column for MP/SP
            type_entry = tk.Entry(frame_row, width=10, justify='center')
            type_entry.insert(0, detected_type)
            type_entry.pack(side='left', padx=10)
            type_entry.bind("<KeyRelease>", lambda e, te=type_entry: self.update_sample_type_color(te))
            self.update_sample_type_color(type_entry)

            self.sample_vars[samp] = var
            self.sample_group_entries[samp] = entry

            # default MP/SP in sample_type_overrides
            self.sample_type_overrides[samp] = type_entry.get().strip().upper()
            
            if not hasattr(self, 'sample_type_entries'):
                self.sample_type_entries = {}
            self.sample_type_entries[samp] = type_entry

        ok_button = tk.Button(self.sample_window, text="OK", command=self.on_sample_selection_ok)
        ok_button.grid(row=3, column=0, columnspan=2, sticky='e', padx=10, pady=10)

    def update_sample_type_color(self, entry):
        """Change background color for MP/SP."""
        value = entry.get().strip().upper()
        if value == "MP":
            entry.config(bg="#ADD8E6")
        elif value == "SP":
            entry.config(bg="#D8BFD8")
        else:
            entry.config(bg="white")

    def on_deselect_all_clicked(self):
        if self.deselect_all_var.get() == 1:
            for var in self.sample_vars.values():
                var.set(0)
        else:
            for var in self.sample_vars.values():
                var.set(1)

    def on_sample_selection_ok(self):
        self.selected_samples = []
        self.sample_group_overrides = {}
        for sample_name, var in self.sample_vars.items():
            if var.get() == 1:
                self.selected_samples.append(sample_name)
                override = self.sample_group_entries[sample_name].get()
                self.sample_group_overrides[sample_name] = override
                
                self.sample_type_overrides[sample_name] = self.sample_type_entries[sample_name].get().strip().upper()
        self.sample_window.destroy()
        self.output_text.insert(tk.END, f"Selected {len(self.selected_samples)} sample(s) for merging.\n")

    def exclude_proteins_checked(self):
        if self.exclude_proteins_var.get():
            self.proteins_to_exclude_set = False
            self.open_protein_selection_window()
        else:
            self.proteins_to_exclude = []
            self.proteins_to_exclude_set = False
            self.exclude_proteins_label.config(fg='black')

    def open_protein_selection_window(self):
        ia_files = []
        for root, dirs, files in os.walk(self.input_folder):
            for file in files:
                if file.endswith('IA_final_peptide.csv'):
                    ia_files.append(os.path.join(root, file))

        protein_entries = set()
        for file_path in ia_files:
            try:
                df = pd.read_csv(file_path, encoding='latin-1')
                if 'protein.Entry' in df.columns:
                    protein_entries.update(df['protein.Entry'].dropna().unique())
            except Exception as e:
                messagebox.showerror("Error", f"Error processing {file_path}: {e}")

        if not protein_entries:
            messagebox.showinfo("Info", "No proteins found to exclude.")
            return

        self.protein_window = tk.Toplevel(self.master)
        self.protein_window.title("Exclude Proteins")

        label = tk.Label(self.protein_window, text="Select proteins to include (uncheck to exclude):")
        label.pack()

        canvas = tk.Canvas(self.protein_window)
        scrollbar = tk.Scrollbar(self.protein_window, orient="vertical", command=canvas.yview)
        scrollable_frame = tk.Frame(canvas)
        scrollable_frame.bind("<Configure>", lambda e: canvas.configure(scrollregion=canvas.bbox("all")))
        canvas.create_window((0, 0), window=scrollable_frame, anchor="nw")
        canvas.configure(yscrollcommand=scrollbar.set)
        canvas.pack(side="left", fill="both", expand=True)
        scrollbar.pack(side="right", fill="y")

        self.protein_vars = {}
        for protein in sorted(protein_entries):
            var = tk.IntVar(value=1)
            chk = tk.Checkbutton(scrollable_frame, text=protein, variable=var)
            chk.pack(anchor='w')
            self.protein_vars[protein] = var

        ok_button = tk.Button(self.protein_window, text="OK", command=self.on_protein_selection_ok)
        ok_button.pack()

    def on_protein_selection_ok(self):
        self.proteins_to_exclude = [protein for protein, var in self.protein_vars.items() if var.get() == 0]
        self.proteins_to_exclude_set = True
        if self.proteins_to_exclude:
            self.exclude_proteins_label.config(fg='green')
        else:
            self.exclude_proteins_label.config(fg='black')
        self.protein_window.destroy()

    def process_files(self):
        self.input_folder = self.input_entry.get()
        if not os.path.isdir(self.input_folder):
            messagebox.showerror("Error", "Invalid input folder selected.")
            return

        if self.exclude_proteins_var.get():
            if not self.proteins_to_exclude_set:
                self.open_protein_selection_window()
                self.master.wait_window(self.protein_window)

        sample_replicate_threshold = self.get_int_value(self.sample_replicate_threshold_entry.get())
        min_product_aa = self.get_float_value(self.min_product_aa_entry.get())
        precursor_inten = self.get_float_value(self.precursor_inten_entry.get())
        min_peptide_length = self.get_int_value(self.min_peptide_length_entry.get())
        max_peptide_length = self.get_int_value(self.max_peptide_length_entry.get())
        min_matched_products = self.get_int_value(self.min_matched_products_entry.get())
        min_consec_matched_products = self.get_int_value(self.min_consec_matched_products_entry.get())
        min_matched_products_inten = self.get_float_value(self.min_matched_products_inten_entry.get())
        min_peptide_score = self.get_float_value(self.min_peptide_score_entry.get())
        min_delta_mhp_ppm = self.get_float_value(self.min_delta_mhp_ppm_entry.get())
        max_delta_mhp_ppm = self.get_float_value(self.max_delta_mhp_ppm_entry.get())
        retention_time_rsd = self.get_float_value(self.std_deviation_entry.get())

        self.output_text.delete(1.0, tk.END)

        if not self.selected_samples:
            self.output_text.insert(tk.END, "No samples selected. Please select at least one sample.\n")
            return

        with tempfile.TemporaryDirectory() as temp_folder:
            self.output_text.insert(tk.END, "Renaming and copying files...\n")
            # rename_csv_files now returns a dictionary: new_path to original sample name
            self.renamed_dict = rename_csv_files(
                self.input_folder,
                temp_folder,
                self.selected_samples,
                self.sample_group_overrides
            )
            if not self.renamed_dict:
                self.output_text.insert(tk.END, "No files found to process after renaming.\n")
                return

            file_groups = self.group_files_by_separation_time_and_trendline(temp_folder)
            group_dfs = []
            for group_name, files in file_groups.items():
                self.output_text.insert(tk.END, f"\nProcessing group: {group_name}\n")
                self.output_text.insert(tk.END, "Merging the following files:\n")
                for file_path in files:
                    self.output_text.insert(tk.END, f"  {os.path.basename(file_path)}\n")

                group_df = self.process_group(files, group_name, sample_replicate_threshold, retention_time_rsd)
                if not group_df.empty:
                    group_dfs.append(group_df)
                else:
                    self.output_text.insert(tk.END, f"No data left after processing group: {group_name}\n")

            if group_dfs:
                merged_df = pd.concat(group_dfs, ignore_index=True)
                self.output_text.insert(
                    tk.END,
                    f"\nTotal peptides after merging all groups: {merged_df.shape[0]} "
                    f"({merged_df['peptide.seq'].nunique()} unique)\n"
                )
            else:
                self.output_text.insert(tk.END, "No data left after processing all groups.\n")
                return

            merged_df = self.apply_remaining_filters(
                merged_df,
                min_product_aa,
                precursor_inten,
                min_peptide_length,
                max_peptide_length,
                min_matched_products,
                min_consec_matched_products,
                min_matched_products_inten,
                min_peptide_score,
                min_delta_mhp_ppm,
                max_delta_mhp_ppm
            )
            if merged_df.empty:
                self.output_text.insert(tk.END, "No data left after applying filters.\n")
                return

            # Sort & deduplicate 
            merged_df = merged_df.sort_values(by='peptide.score', ascending=False)
            merged_df = merged_df.drop_duplicates(subset='peptide.seq', keep='first')

            if 'peptide.componentID' in merged_df.columns:
                merged_df['peptide.componentID'] = range(1, len(merged_df) + 1)
            else:
                self.output_text.insert(tk.END, "Warning: 'peptide.componentID' column not found.\n")

            self.output_text.insert(
                tk.END,
                f"Final peptides after sorting and deduplication: {merged_df.shape[0]} "
                f"({merged_df['peptide.seq'].nunique()} unique)\n"
            )

            # Suspicious peptide review more logic
            suspicious_df = merged_df.copy()
            suspicious_df['rt_round'] = suspicious_df['precursor.retT'].round(2)

            if 'peptide.seq' in suspicious_df.columns:
                suspicious_df['theo_mass'] = suspicious_df['peptide.seq'].apply(lambda s: calculate_theoretical_mass(str(s)))
            else:
                suspicious_df['theo_mass'] = None
            suspicious_df['theo_round'] = suspicious_df['theo_mass'].apply(lambda x: round(x,1) if x is not None else None)

            group_counts = suspicious_df.groupby(['rt_round','theo_round']).size()
            suspicious_groups = group_counts[group_counts >= 2].index
            susp_mask = suspicious_df.set_index(['rt_round','theo_round']).index.isin(suspicious_groups)
            susp_df = suspicious_df[susp_mask].copy()

            if not susp_df.empty:
                susp_df.drop(columns=['rt_round','theo_round'], inplace=True, errors='ignore')

                review_win = SuspiciousReviewWindow(self.master, susp_df)
                self.master.wait_window(review_win)

                if review_win.result is not None:
                    all_susp_indices = susp_df.index.tolist()
                    to_remove = [idx for idx in all_susp_indices if idx not in review_win.result]
                    merged_df = merged_df.drop(index=to_remove)

            self.output_text.insert(
                tk.END,
                f"Final peptides after suspicious-peptide review: {merged_df.shape[0]} "
                f"({merged_df['peptide.seq'].nunique()} unique)\n"
            )

            parent_directory = os.path.dirname(self.input_folder)
            output_folder = os.path.join(parent_directory, "Merged_final_peptide_excel_sheets")
            os.makedirs(output_folder, exist_ok=True)

            # Output files format
            if self.output_format_var.get() == "HDExaminer":
                
                merged_df['sample_type'] = merged_df['origin_file'].apply(
                    lambda sample: self.sample_type_overrides.get(sample, "")
                )
                new_cols = ['origin_file', 'sample_type'] + [c for c in merged_df.columns if c not in ['origin_file','sample_type']]
                merged_df = merged_df[new_cols]

                # Split merged_df into two: one for MP and one for SP
                df_mp = merged_df[merged_df['sample_type'] == 'MP']
                df_sp = merged_df[merged_df['sample_type'] == 'SP']

                timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
                final_count_mp = df_mp.shape[0]
                final_count_sp = df_sp.shape[0]
                output_filename_mp = f"{timestamp}_{final_count_mp}_Multi_pass_peptides_only_IA_final_peptide.csv"
                output_filename_sp = f"{timestamp}_{final_count_sp}_Single_pass_peptides_only_IA_final_peptide.csv"
                output_path_mp = os.path.join(output_folder, output_filename_mp)
                output_path_sp = os.path.join(output_folder, output_filename_sp)

                df_mp.to_csv(output_path_mp, index=False, encoding='latin-1')
                df_sp.to_csv(output_path_sp, index=False, encoding='latin-1')

                self.output_text.insert(tk.END, f"\nFinal MP peptides saved to: {output_path_mp}\n")
                self.output_text.insert(tk.END, f"Final SP peptides saved to: {output_path_sp}\n")
                messagebox.showinfo("Success", f"Processing completed.\nMP peptides: {output_path_mp}\nSP peptides: {output_path_sp}")
            else:
                timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
                final_count = merged_df.shape[0]
                output_filename = f"{timestamp}_{final_count}_IA_final_peptide.csv"
                output_path = os.path.join(output_folder, output_filename)
                merged_df.to_csv(output_path, index=False, encoding='latin-1')
                self.output_text.insert(tk.END, f"\nFinal result saved to: {output_path}\n")
                messagebox.showinfo("Success", f"Processing completed. Final result saved to: {output_path}")

        # Reset for next run
        self.proteins_to_exclude = []
        self.proteins_to_exclude_set = False
        self.exclude_proteins_var.set(0)
        self.exclude_proteins_checkbox.config(state=tk.DISABLED)
        self.exclude_proteins_label.config(fg='black')
        self.selected_samples = []
        self.sample_group_overrides = {}

    def group_files_by_separation_time_and_trendline(self, folder_path):
        """
        Groups files by the first three underscore-delimited tokens in the filename:
          e.g. "0_3_OriginalSample" -> group "0_3_OriginalSample"
        """
        file_groups = {}
        for file in os.listdir(folder_path):
            if file.endswith(".csv"):
                file_path = os.path.join(folder_path, file)
                file_name_without_ext = os.path.splitext(file)[0]
                parts = file_name_without_ext.split('_')
                if len(parts) >= 3:
                    group_key = "_".join(parts[:3])
                else:
                    group_key = file_name_without_ext
                file_groups.setdefault(group_key, []).append(file_path)
        return file_groups

    def process_group(self, files, group_name, sample_replicate_threshold, retention_time_rsd):
        group_df = pd.DataFrame()
        for file_path in files:
            try:
                # Read .CSV
                df = pd.read_csv(file_path, encoding='latin-1')
                if df.empty:
                    self.output_text.insert(tk.END, f"File '{file_path}' is empty, skipping.\n")
                    continue

                df['peptide.score'] = pd.to_numeric(df['peptide.score'], errors='coerce')
                # Set origin_file to the original sample name from self.renamed_dict
                df['origin_file'] = self.renamed_dict[file_path]

                group_df = pd.concat([group_df, df], ignore_index=True)
            except Exception as e:
                self.output_text.insert(tk.END, f"Error reading file '{file_path}': {e}\n")

        if group_df.empty:
            self.output_text.insert(tk.END, f"No data found in group: {group_name}\n")
            return group_df

        total_peptides = group_df.shape[0]
        unique_peptides = group_df['peptide.seq'].nunique()
        self.output_text.insert(
            tk.END,
            f"Total peptides before filtering in group {group_name}: {total_peptides} ({unique_peptides} unique)\n"
        )

        group_df = group_df[group_df['peptide.score'].notna() & (group_df['peptide.score'] > 0)]
        if group_df.empty:
            self.output_text.insert(tk.END, f"No data left after removing peptides with score <= 0 in group: {group_name}\n")
            return group_df

        if self.proteins_to_exclude:
            group_df = group_df[~group_df['protein.Entry'].isin(self.proteins_to_exclude)]
            if group_df.empty:
                self.output_text.insert(tk.END, f"No data left after protein exclusion in group: {group_name}\n")
                return group_df

        numeric_columns = [
            'peptide.MatchedProducts', 'peptide.seqLength', 'precursor.inten',
            'peptide.score', 'peptide.MatchedProductsSumInten',
            'peptidePrecursor.deltaMhpPPM', 'peptide.ConsectiveMatchedProducts'
        ]
        for col in numeric_columns:
            if col in group_df.columns:
                group_df[f'avg_{col}'] = group_df.groupby('peptide.seq')[col].transform('mean')

        if sample_replicate_threshold is not None:
            peptide_counts = group_df.groupby('peptide.seq')['peptide.seq'].transform('count')
            group_df = group_df[peptide_counts >= sample_replicate_threshold]
            self.output_text.insert(
                tk.END,
                f"Peptides after sample replicate threshold in group {group_name}: {group_df.shape[0]} ({group_df['peptide.seq'].nunique()} unique)\n"
            )
        else:
            self.output_text.insert(tk.END, f"Skipping sample replicate threshold in group {group_name} (parameter not set or zero).\n")

        if group_df.empty:
            self.output_text.insert(tk.END, f"No data left after applying sample replicate threshold in group: {group_name}\n")
            return group_df

        # If replicate threshold >= 3, optionally do retention time RSD
        if (sample_replicate_threshold is not None and sample_replicate_threshold >= 3 and
                retention_time_rsd is not None and 'precursor.retT' in group_df.columns):
            grouped_df = group_df.groupby('peptide.seq')
            for peptide_seq, group_df_inner in grouped_df:
                average = group_df_inner['precursor.retT'].mean()
                deviations = (group_df_inner['precursor.retT'] - average) ** 2
                sum_squared_results = deviations.sum()
                num_datapoints = group_df_inner.shape[0]
                if num_datapoints > 0:
                    variance = sum_squared_results / num_datapoints
                    standard_deviation = variance ** 0.5
                    relative_standard_deviation = (standard_deviation * 100) / average if average != 0 else 0
                    truncated_rsd = int(relative_standard_deviation * 10) / 10.0
                    group_df.loc[group_df_inner.index, 'relative SD'] = truncated_rsd
            group_df = group_df[group_df['relative SD'] <= retention_time_rsd]
            self.output_text.insert(
                tk.END,
                f"Peptides after retention time RSD threshold in group {group_name}: {group_df.shape[0]} ({group_df['peptide.seq'].nunique()} unique)\n"
            )
        else:
            self.output_text.insert(
                tk.END,
                f"Skipping retention time RSD calculation in group {group_name} (replicate threshold < 3, no retT column, or parameter not set).\n"
            )

        if group_df.empty:
            self.output_text.insert(tk.END, f"No data left after applying retention time RSD in group: {group_name}\n")
            return group_df

        return group_df

    def apply_remaining_filters(self, df, min_product_aa, precursor_inten, min_peptide_length,
                                max_peptide_length, min_matched_products, min_consec_matched_products,
                                min_matched_products_inten, min_peptide_score, min_delta_mhp_ppm,
                                max_delta_mhp_ppm):
        if min_peptide_score is not None:
            df = df[df['avg_peptide.score'] >= min_peptide_score]
            self.output_text.insert(
                tk.END,
                f"Peptides after score filter: {df.shape[0]} ({df['peptide.seq'].nunique()} unique)\n"
            )
        else:
            self.output_text.insert(tk.END, "Skipping score filter (parameter not set or zero).\n")

        if df.empty:
            return df

        if min_product_aa is not None:
            rounded_products = df['avg_peptide.MatchedProducts'].round()
            truncated_product_aa = (rounded_products / df['avg_peptide.seqLength']).apply(lambda x: int(x * 100) / 100.0)
            df = df[truncated_product_aa >= min_product_aa]
            self.output_text.insert(
                tk.END,
                f"Peptides after products per amino acid filter: {df.shape[0]} ({df['peptide.seq'].nunique()} unique)\n"
            )
        else:
            self.output_text.insert(tk.END, "Skipping products per amino acid filter (parameter not set or zero).\n")

        if df.empty:
            return df

        if precursor_inten is not None:
            df = df[df['avg_precursor.inten'] >= precursor_inten]
            self.output_text.insert(
                tk.END,
                f"Peptides after intensity filter: {df.shape[0]} ({df['peptide.seq'].nunique()} unique)\n"
            )
        else:
            self.output_text.insert(tk.END, "Skipping intensity filter (parameter not set or zero).\n")

        if df.empty:
            return df

        if (min_peptide_length is not None) or (max_peptide_length is not None):
            if min_peptide_length is not None and max_peptide_length is not None:
                df = df[(df['avg_peptide.seqLength'] >= min_peptide_length) &
                        (df['avg_peptide.seqLength'] <= max_peptide_length)]
            elif min_peptide_length is not None:
                df = df[df['avg_peptide.seqLength'] >= min_peptide_length]
            elif max_peptide_length is not None:
                df = df[df['avg_peptide.seqLength'] <= max_peptide_length]
            self.output_text.insert(
                tk.END,
                f"Peptides after sequence length filter: {df.shape[0]} ({df['peptide.seq'].nunique()} unique)\n"
            )
        else:
            self.output_text.insert(tk.END, "Skipping sequence length filter (parameters not set or zero).\n")

        if df.empty:
            return df

        if min_matched_products is not None:
            rounded_matched_products = df['avg_peptide.MatchedProducts'].round()
            df = df[rounded_matched_products >= min_matched_products]
            self.output_text.insert(
                tk.END,
                f"Peptides after matched products filter: {df.shape[0]} ({df['peptide.seq'].nunique()} unique)\n"
            )
        else:
            self.output_text.insert(tk.END, "Skipping matched products filter (parameter not set or zero).\n")

        if df.empty:
            return df

        if min_consec_matched_products is not None:
            rounded_consec_products = df['avg_peptide.ConsectiveMatchedProducts'].round()
            df = df[rounded_consec_products >= min_consec_matched_products]
            self.output_text.insert(
                tk.END,
                f"Peptides after consecutive products filter: {df.shape[0]} ({df['peptide.seq'].nunique()} unique)\n"
            )
        else:
            self.output_text.insert(tk.END, "Skipping consecutive products filter (parameter not set or zero).\n")

        if df.empty:
            return df

        if min_matched_products_inten is not None:
            df = df[df['avg_peptide.MatchedProductsSumInten'] >= min_matched_products_inten]
            self.output_text.insert(
                tk.END,
                f"Peptides after sum intensity for products filter: {df.shape[0]} ({df['peptide.seq'].nunique()} unique)\n"
            )
        else:
            self.output_text.insert(tk.END, "Skipping sum intensity for products filter (parameter not set or zero).\n")

        if df.empty:
            return df

        if (min_delta_mhp_ppm is not None) or (max_delta_mhp_ppm is not None):
            if min_delta_mhp_ppm is not None and max_delta_mhp_ppm is not None:
                df = df[
                    (df['avg_peptidePrecursor.deltaMhpPPM'] >= min_delta_mhp_ppm) &
                    (df['avg_peptidePrecursor.deltaMhpPPM'] <= max_delta_mhp_ppm)
                ]
            elif min_delta_mhp_ppm is not None:
                df = df[df['avg_peptidePrecursor.deltaMhpPPM'] >= min_delta_mhp_ppm]
            elif max_delta_mhp_ppm is not None:
                df = df[df['avg_peptidePrecursor.deltaMhpPPM'] <= max_delta_mhp_ppm]
            self.output_text.insert(
                tk.END,
                f"Peptides after mass error filter: {df.shape[0]} ({df['peptide.seq'].nunique()} unique)\n"
            )
        else:
            self.output_text.insert(tk.END, "Skipping mass error filter (parameters not set or zero).\n")

        numeric_columns = [
            'peptide.MatchedProducts', 'peptide.seqLength', 'precursor.inten',
            'peptide.score', 'peptide.MatchedProductsSumInten',
            'peptidePrecursor.deltaMhpPPM', 'peptide.ConsectiveMatchedProducts'
        ]
        drop_cols = [f'avg_{col}' for col in numeric_columns if f'avg_{col}' in df.columns]
        df = df.drop(columns=drop_cols, errors='ignore')

        if 'relative SD' in df.columns:
            df = df.drop(columns=['relative SD'])

        return df


