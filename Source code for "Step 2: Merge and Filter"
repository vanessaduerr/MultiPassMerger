def clean_underscores(file_name):
    """Remove extra underscores from file names to ensure renaming is done correctly."""
    return re.sub(r'_{2,}', '_', file_name)

def extract_separation_time(file_name):
    """
    Extract separation time from the file name:
    Looks for '<number>ms' or '<number>s'.
    Returns the number as a string or None if not found.
    """
    ms_match = re.search(r'(\d+)ms', file_name)
    s_match = re.search(r'(\d+)s', file_name)
    if ms_match:
        return ms_match.group(1)
    elif s_match:
        return s_match.group(1)
    else:
        return None  # If no separation time found

def extract_trendline(old_path):
    """
    Extract the trendline folder name (e.g. '3_9') from the directory hierarchy.
    We assume the pattern is digits + underscore + digits in some parent folder.
    If not found, returns 'NoTrendline'.
    """
    current_folder = os.path.dirname(old_path)
    while True:
        folder_name = os.path.basename(current_folder)
        if re.match(r'^\d+_\d+$', folder_name):
            return folder_name
        parent_folder = os.path.dirname(current_folder)
        if parent_folder == current_folder:
            break
        current_folder = parent_folder
    return 'NoTrendline'

def get_all_sample_names(folder_path):
    """
    Recursively collects the base file names (without extension) for all
    CSV files named '*IA_final_peptide.csv' and returns a sorted list of unique names.
    """
    all_samples = set()
    for root, dirs, files in os.walk(folder_path):
        for file in files:
            if file.endswith("IA_final_peptide.csv"):
                base_name = os.path.splitext(file)[0]
                all_samples.add(base_name)
    return sorted(all_samples)

def rename_csv_files(folder_path, temp_folder, selected_samples, sample_groups):
    """
    Rename and copy only those files whose base names are in 'selected_samples'.
    'sample_groups' is a dictionary mapping sample name -> user override (the user-chosen group name).

    Returns a dictionary mapping:
       new_csv_path -> original_sample_name
    so we can later set 'origin_file' to match the exact original sample name.
    """
    renamed_dict = {}
    for root, dirs, files in os.walk(folder_path):
        for file in files:
            if file.endswith("IA_final_peptide.csv"):
                file_name_without_ext = os.path.splitext(file)[0]
                if file_name_without_ext not in selected_samples:
                    continue
                old_path = os.path.join(root, file)
                trendline = extract_trendline(old_path)
                separation_time = sample_groups.get(file_name_without_ext, "0")
                if not separation_time:
                    separation_time = "0"
                # Build new file name
                new_file_name = f"{separation_time}_{trendline}_{file_name_without_ext}.csv"
                new_file_name = clean_underscores(new_file_name)
                new_path = os.path.join(temp_folder, new_file_name)
                shutil.copy2(old_path, new_path)
                # Store the mapping:new_path to original sample name
                renamed_dict[new_path] = file_name_without_ext
    return renamed_dict


# supicious peptides review logic
def calculate_theoretical_mass(peptide_seq, aa_masses=None, water_mass=18.01056):
    """
    Calculate sum of amino acid masses + water mass.
    """
    if aa_masses is None:
        aa_masses = {
            'A': 71.037113805, 'R': 156.101111050, 'N': 114.042927470, 'D': 115.026943065,
            'C': 103.009184505, 'E': 129.042593135, 'Q': 128.058577540, 'G': 57.021463735,
            'H': 137.058911875, 'I': 113.084064015, 'L': 113.084064015, 'K': 128.094963050,
            'M': 131.040484645, 'F': 147.068413945, 'P': 97.052763875,  'S': 87.032028435,
            'T': 101.047678505, 'W': 186.079312980, 'Y': 163.063328575, 'V': 99.068413945
        }
    try:
        base_mass = sum(aa_masses.get(aa, 0) for aa in peptide_seq)
        return base_mass + water_mass
    except:
        return None

# Suspicious Peptide review window

class SuspiciousReviewWindow(tk.Toplevel):
    def __init__(self, master, suspicious_df):
        """
        Groups are determined by rounding retT to 2 decimals and the theoretical mass to 1 decimal.
        Each group is shown in a bold, solid-bordered LabelFrame. The top has a pinned message with
        an emoji and instructions, so it doesn't scroll.
        """
        super().__init__(master)
        self.title("Review Suspicious Peptides")
        self.geometry("1020x540")  
        self.result = {}
        self.selected_vars = {}
        self.suspicious_df = suspicious_df

        
        self.grid_rowconfigure(2)
        self.grid_columnconfigure(0)

    
        top_message_frame = tk.Frame(self)
        top_message_frame.grid(row=0, column=0, columnspan=2, sticky='nw', padx=5, pady=5)

        emoji_label = tk.Label(
            top_message_frame,
            text="\U0001F928",   
            font=('Arial', 30, 'bold'),
            fg='black'
        )
        emoji_label.grid(row=0, column=0, sticky='w')

        instructions_text = (
            "Suspicious peptides: These peptides have very similar retention times "
            "and theoretical masses. Check that they are not assigned twice. "
            "If in doubt, choose the peptide with the most matched products (orange)."
        )
        instructions_label = tk.Label(
            top_message_frame,
            text=instructions_text,
            font=('Arial', 10, 'bold'),
            fg='black',
            wraplength=880,
            justify='left'
        )
        instructions_label.grid(row=0, column=1, padx=7, sticky='w')

        # scrollable window 
        canvas = tk.Canvas(self, width=1000, height=370, scrollregion=(0, 0, 2000, 2000))
        v_scrollbar = tk.Scrollbar(self, orient="vertical", command=canvas.yview)
        h_scrollbar = tk.Scrollbar(self, orient="horizontal", command=canvas.xview)

        self.main_frame = tk.Frame(canvas)
        self.main_frame.bind("<Configure>", lambda e: canvas.configure(scrollregion=canvas.bbox("all")))
        canvas.create_window((0, 0), window=self.main_frame, anchor="nw")

        canvas.configure(yscrollcommand=v_scrollbar.set, xscrollcommand=h_scrollbar.set)
        canvas.grid(row=1, column=0, sticky="nsew")
        v_scrollbar.grid(row=1, column=1, sticky="ns")
        h_scrollbar.grid(row=2, column=0, columnspan=2, sticky="ew")

        #  theoretical mass 
        if 'peptide.seq' in self.suspicious_df.columns:
            self.suspicious_df['theo_mass'] = self.suspicious_df['peptide.seq'].apply(
                lambda seq: calculate_theoretical_mass(str(seq))
            )
        else:
            self.suspicious_df['theo_mass'] = None

        # Group by rounded retT, rounded theoretical mass
        groups = {}
        for idx, row in self.suspicious_df.iterrows():
            retT_rounded = round(row.get('precursor.retT', 0), 2)
            theo = row.get('theo_mass', None)
            theo_rounded = round(theo, 1) if theo is not None else None
            groups.setdefault((retT_rounded, theo_rounded), []).append((idx, row))

        current_row = 0
        for (ret_val, theo_val), items in groups.items():
            if len(items) < 2:
                continue

            # find max matched products 
            max_matched = max(
                r.get('peptide.MatchedProducts', 0)
                for _, r in items
                if pd.notna(r.get('peptide.MatchedProducts', None))
            )

            
            group_label = f"Group retT={ret_val}, mass={theo_val}"
            lf = tk.LabelFrame(
                self.main_frame,
                text=group_label,
                bd=2,
                relief=tk.SOLID,
                padx=4,
                pady=4,
                font=('Arial', 8, 'bold')
            )
            lf.grid(row=current_row, column=0, padx=4, pady=4, sticky="ew")
            current_row += 1

            
            tk.Label(lf, text="Keep", width=10, font=('Arial', 10, 'bold'), anchor='center')\
                .grid(row=0, column=0, rowspan=2, sticky='nsew')

            tk.Label(lf, text="Sequence", width=30, font=('Arial', 10, 'bold'), anchor='w')\
                .grid(row=0, column=1, sticky='nsew')
            tk.Label(lf, text="(peptide.seq)", width=30, font=('Arial', 8), anchor='w')\
                .grid(row=1, column=1, sticky='nsew')

            tk.Label(lf, text="Retention time", width=17, font=('Arial', 10, 'bold'), anchor='w')\
                .grid(row=0, column=2, sticky='nsew')
            tk.Label(lf, text="(precursor.retT)", width=17, font=('Arial', 8), anchor='w')\
                .grid(row=1, column=2, sticky='nsew')

            tk.Label(lf, text="Theoretical mass", width=17, font=('Arial', 10, 'bold'), anchor='w')\
                .grid(row=0, column=3, sticky='nsew')
            tk.Label(lf, text="(SUM aa+18.01056)", width=17, font=('Arial', 8), anchor='w')\
                .grid(row=1, column=3, sticky='nsew')

            tk.Label(lf, text="Experimental mass", width=17, font=('Arial', 10, 'bold'), anchor='w')\
                .grid(row=0, column=4, sticky='nsew')
            tk.Label(lf, text="((mz*z)-(1.00784*z))", width=17, font=('Arial', 8), anchor='w')\
                .grid(row=1, column=4, sticky='nsew')

            tk.Label(lf, text="Mass error", width=10, font=('Arial', 10, 'bold'), anchor='w')\
                .grid(row=0, column=5, sticky='nsew')
            tk.Label(lf, text="(ppm)", width=10, font=('Arial', 8), anchor='w')\
                .grid(row=1, column=5, sticky='nsew')

            tk.Label(lf, text="No. of matched products", width=20, font=('Arial', 10, 'bold'), anchor='w')\
                .grid(row=0, column=6, sticky='nsew')
            tk.Label(lf, text="(peptide.MatchedProducts)", width=20, font=('Arial', 8), anchor='w')\
                .grid(row=1, column=6, sticky='nsew')

            tk.Label(lf, text="Matched products", width=20, font=('Arial', 10, 'bold'), anchor='w')\
                .grid(row=0, column=7, sticky='nsew')
            tk.Label(lf, text="(peptide.MatchedProductsString)", width=20, font=('Arial', 8), anchor='w')\
                .grid(row=1, column=7, sticky='nsew')

            for col_idx in range(8):
                lf.grid_columnconfigure(col_idx)

            row_index = 2
            for (real_idx, data_row) in items:
                var = tk.IntVar(value=1)
                self.selected_vars[real_idx] = var

                matched_val = data_row.get('peptide.MatchedProducts', 0)
                color = "orange" if matched_val == max_matched else "red"
                bold_font = ('Arial', 10, 'bold')

                # Column 0: Checkbox
                cb = tk.Checkbutton(lf, variable=var)
                cb.grid(row=row_index, column=0, sticky='nsew')

                # Column 1: Sequence
                seq_val = data_row.get('peptide.seq', '')
                seq_label = tk.Label(lf, text=str(seq_val), fg=color, font=bold_font, anchor='w')
                seq_label.grid(row=row_index, column=1, sticky='nsew')

                # Column 2: Retention time
                ret_val = data_row.get('precursor.retT', '')
                ret_label = tk.Label(lf, text=str(ret_val), fg=color, font=bold_font, anchor='w')
                ret_label.grid(row=row_index, column=2, sticky='nsew')

                # Column 3: Theoretical mass
                theo_mass_str = ""
                if 'theo_mass' in data_row and data_row['theo_mass'] is not None:
                    theo_mass_str = f"{data_row['theo_mass']:.5f}"
                theo_label = tk.Label(lf, text=theo_mass_str, fg=color, font=bold_font, anchor='w')
                theo_label.grid(row=row_index, column=3, sticky='nsew')

                # Column 4: Experimental mass = (mz*z) - (1.00784*z)
                exp_mass_str = ""
                try:
                    mz_val = float(data_row['precursor.mz'])
                    z_val = float(data_row['precursor.z'])
                    exp_mass = (mz_val * z_val) - (1.00784 * z_val)
                    exp_mass_str = f"{exp_mass:.5f}"
                except:
                    pass
                exp_mass_label = tk.Label(lf, text=exp_mass_str, fg=color, font=bold_font, anchor='w')
                exp_mass_label.grid(row=row_index, column=4, sticky='nsew')

                # Column 5: Mass error (ppm)
                mass_error_str = ""
                try:
                    if exp_mass_str and theo_mass_str:
                        exp_val = float(exp_mass_str)
                        theo_val = float(theo_mass_str)
                        if theo_val != 0:
                            ppm = ((exp_val - theo_val) / theo_val) * 1e6
                            mass_error_str = f"{ppm:.1f}"
                except:
                    pass
                mass_label = tk.Label(lf, text=mass_error_str, fg=color, font=bold_font, anchor='w')
                mass_label.grid(row=row_index, column=5, sticky='nsew')

                # Column 6: No. of matched products
                mp_label = tk.Label(lf, text=str(matched_val), fg=color, font=bold_font, anchor='w')
                mp_label.grid(row=row_index, column=6, sticky='nsew')

                # Column 7: Matched products string
                matched_str = data_row.get('peptide.MatchedProductsString', '')
                matched_str_label = tk.Label(lf, text=str(matched_str), fg=color, font=bold_font, anchor='w')
                matched_str_label.grid(row=row_index, column=7, sticky='nsew')

                row_index += 1

        if current_row == 0:
            tk.Label(
                self.main_frame,
                text="No suspicious peptides found!",
                font=('Arial', 12)
            ).grid(row=0, column=0, padx=10, pady=10)

        apply_button = tk.Button(self, text="Apply Selection", command=self.apply_selection)
        apply_button.grid(row=3, column=0, columnspan=2, pady=10)

    def apply_selection(self):
        accepted_indices = []
        for row_idx, var in self.selected_vars.items():
            if var.get() == 1:
                accepted_indices.append(row_idx)
        self.result = accepted_indices
        self.destroy()

